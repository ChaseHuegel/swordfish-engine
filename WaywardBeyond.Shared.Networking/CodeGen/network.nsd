#version 1.0;
#namespace WaywardBeyond.Shared.Networking;

message ComponentSnapshot
{
    ulong Entity    = 0;
    ulong TypeUuid  = 1;
    byte[] Payload  = 2;
}

message WorldSnapshot
{
    uint TickNumber           = 0;
    uint LastProcessedInput   = 1;
    ComponentSnapshot[] Components     = 2;
    ulong[] RemovedEntities   = 3;
}

message SpawnRequest
{
    ulong CharacterId   = 0;
    string LevelGuid    = 1;
}

message SpawnResponse
{
    ulong Entity    = 0;
    bool  Accepted  = 1;
}

message TransformMessage
{
    float PositionX      = 0;
    float PositionY      = 1;
    float PositionZ      = 2;
    float OrientationX   = 3;
    float OrientationY   = 4;
    float OrientationZ   = 5;
    float OrientationW   = 6;
    float ScaleX         = 7;
    float ScaleY         = 8;
    float ScaleZ         = 9;
}

message PhysicsMessage
{
    float VelocityX          = 0;
    float VelocityY          = 1;
    float VelocityZ          = 2;
    float AngularVelocityX   = 3;
    float AngularVelocityY   = 4;
    float AngularVelocityZ   = 5;
}