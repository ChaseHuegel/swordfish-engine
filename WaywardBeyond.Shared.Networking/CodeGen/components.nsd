#version 1.0;
#namespace WaywardBeyond.Shared.Networking.Components;

message InputComponent
{
    float MovementX           = 0;
    float MovementY           = 1;
    float MovementZ           = 2;
    float LookX               = 3;
    float LookY               = 4;
    float LookZ               = 5;
    float LookW               = 6;
    bool  Jump                = 7;
    uint  SequenceNumber      = 8;
    uint  ServerTickAtSample  = 9;
}