#version 1.0;
#namespace WaywardBeyond.Shared.Networking.Components;

message InputComponent
{
    float MovementX           = 0;
    float MovementY           = 1;
    float MovementZ           = 2;
    float LookPitch           = 3;
    float LookYaw             = 4;
    float LookRoll            = 5;
    bool  Jump                = 6;
    uint  SequenceNumber      = 7;
    uint  ServerTickAtSample  = 8;
}