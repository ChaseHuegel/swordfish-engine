#version 1.0;
#namespace WaywardBeyond.Shared.Networking.Components;

message InputComponent
{
    float MovementX           = 0;
    float MovementY           = 1;
    float MovementZ           = 2;
    float LookPitch           = 3;
    float LookYaw             = 4;
    float LookRoll            = 5;
    uint  SequenceNumber      = 6;
    uint  ServerTickAtSample  = 7;
    uint  HeldSlot            = 8;
    bool  PrimaryHeld         = 9;
    bool  SecondaryHeld       = 10;
}

message BodyViewComponent
{
    int Body = 0;
}

message IdentifierMessage
{
    string Name = 0;
    string Tag  = 1;
}

message EquipmentComponent
{
    int ActiveInventorySlot = 0;
}

message InventoryComponent
{
    WaywardBeyond.Shared.Data.ItemData[] Contents = 0;
}

message GameModeComponent
{
    int Value = 0;
}

message InteractionEvent
{
    ulong Entity              = 0;
    uint  SequenceNumber      = 1;
    uint  ServerTickAtSample  = 2;
    byte  Kind                = 3;
    BrickInteraction? Brick   = 4;
}

message BrickInteraction
{
    ulong TargetEntity = 0;
    int  TargetX = 1;
    int  TargetY = 2;
    int  TargetZ = 3;
    byte HintShape = 4;
    byte HintOrientation = 5;
}