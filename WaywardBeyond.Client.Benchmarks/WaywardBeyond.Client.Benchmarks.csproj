<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaywardBeyond.Client\WaywardBeyond.Client.csproj" />
  </ItemGroup>

  <Target Name="_ExcludeUnusedAssetsFromBenchmarks"
          BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;_CopyOutOfDateSourceItemsToOutputDirectoryAlways;_CopyDifferingSourceItemsToOutputDirectory">
    <ItemGroup>
      <_UnusedBenchmarkAssets Include="@(_SourceItemsToCopyToOutputDirectory);@(_SourceItemsToCopyToOutputDirectoryAlways);@(_SourceItemsToCopyToOutputDirectoryIfDifferent)"
                              Condition="$([System.String]::Copy('%(TargetPath)').StartsWith('assets\', System.StringComparison.OrdinalIgnoreCase))
                                         or $([System.String]::Copy('%(TargetPath)').StartsWith('assets/', System.StringComparison.OrdinalIgnoreCase))" />
      <_SourceItemsToCopyToOutputDirectory Remove="@(_UnusedBenchmarkAssets)" MatchOnMetadata="TargetPath" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_UnusedBenchmarkAssets)" MatchOnMetadata="TargetPath" />
      <_SourceItemsToCopyToOutputDirectoryIfDifferent Remove="@(_UnusedBenchmarkAssets)" MatchOnMetadata="TargetPath" />
    </ItemGroup>
  </Target>

</Project>
