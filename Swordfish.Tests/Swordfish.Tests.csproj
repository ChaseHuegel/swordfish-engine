<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.7.1" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="1.3.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="TestFiles\**\*.*" CopyToOutputDirectory="Always"/>
    <ProjectReference Include="..\Reef\Reef.csproj" />
    
    <ProjectReference Include="..\Swordfish.Library\Swordfish.Library.csproj" />
    <ProjectReference Include="..\Swordfish\Swordfish.csproj" />
    <ProjectReference Include="..\Swordfish.ECS\Swordfish.ECS.csproj" />
    <ProjectReference Include="..\WaywardBeyond.Shared.Networking\WaywardBeyond.Shared.Networking.csproj" />
    <ProjectReference Include="..\WaywardBeyond.Shared.Bricks\WaywardBeyond.Shared.Bricks.csproj" />
    <ProjectReference Include="..\WaywardBeyond.Shared.Bodies\WaywardBeyond.Shared.Bodies.csproj" />
    <ProjectReference Include="..\WaywardBeyond.Server.Core\WaywardBeyond.Server.Core.csproj" />
    <ProjectReference Include="..\WaywardBeyond.Shared.Skills\WaywardBeyond.Shared.Skills.csproj" />
    <None Include="..\WaywardBeyond.Shared.Skills\assets\skills\*.toml" Link="TestFiles\Skills\assets\skills\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <None Include="..\WaywardBeyond.Shared.Skills\assets\lang\tags\*.toml" Link="TestFiles\Skills\assets\lang\tags\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <None Include="..\WaywardBeyond.Shared.Bricks\assets\bricks\*.toml" Link="TestFiles\Bricks\assets\bricks\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <None Include="..\WaywardBeyond.Shared.Bodies\assets\bodies\*.toml" Link="TestFiles\Bodies\assets\bodies\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <None Include="..\WaywardBeyond.Shared.Bodies\assets\textures\characters\*.png" Link="TestFiles\Bodies\assets\textures\characters\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <None Update="TestFiles\Fonts\Font Awesome 6 Free Solid.otf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>