<Reef xmlns="Reef"
      xmlns:param="Reef.Param"
      Class="SkillsView"
      Context="SkillsPanelState"
      RendererData="Swordfish.Graphics.Material"
      Namespace="WaywardBeyond.Client.UI.Layers.Skills">

    <Element class="wb-scrim" layout="none" width="100%" height="100%">
        <Element class="wb-modal-center" layout="none" width="100%" height="100%" clip="true">
            <Modal param:size="feedback">
                <Content name="header">
                    <Element class="wb-skills-header" width="fill" height="30">
                        <Text text="@L('ui.panel.skill.list')" class="wb-modal-title" width="fill" height="30" />
                        <IconButton id="Button_CloseSkillsHeader"
                                    anchor="Center"
                                    param:glyph="xmark"
                                    param:size="28"
                                    param:glyphSize="18"
                                    onclick="OnClose" />
                    </Element>
                </Content>

                <Element class="wb-skills-body" width="fill" height="fill">
                    <Text visible="@context.HasSkills"
                          text="@TotalLevelText(context.TotalLevel)"
                          class="wb-text-small wb-text-accent"
                          width="fill"
                          height="18" />

                    <EmptyState visible="@(!context.HasSkills)">
                        <Text text="@L('ui.message.skill.empty')"
                              class="wb-text-body wb-text-dim"
                              width="fill"
                              height="fill"
                              text-align="center"
                              vertical-align="middle" />
                    </EmptyState>

                    <ScrollArea id="Skills.List"
                                context="@Scroll"
                                visible="@context.HasSkills"
                                width="fill"
                                height="fill">
                        <Element id="Skills.ListContent" class="wb-skills-list" width="fill" height="fit">
                            <ForEach in="@context.Categories" as="group">
                                <Element class="wb-skills-category" width="fill" height="fit">
                                    <Text text="@L(group.CategoryKey)"
                                          class="wb-section-title"
                                          width="fill"
                                          height="22"
                                          wrap="false" />
                                    <Element class="wb-divider-inner" width="fill" height="1" />

                                    <ForEach in="@group.Skills" as="skill">
                                        <Element id="Row_Skill_{skill.ID}" class="wb-skills-card" width="fill" height="72">
                                            <Element class="wb-skills-icon-frame" width="44" height="44" anchor="Center">
                                                <Image source="@skill.Icon"
                                                       width="fill"
                                                       height="fill" />
                                            </Element>
                                            <Element class="wb-skills-details" width="fill" height="fill">
                                                <Element class="wb-skills-row-header" width="fill" height="22">
                                                    <Text text="@L(skill.NameKey)"
                                                          class="wb-text-body"
                                                          width="fill"
                                                          height="fill"
                                                          wrap="false" />
                                                    <Text text="@LevelText(skill.Level)"
                                                          class="wb-skills-level"
                                                          width="fit"
                                                          height="fill"
                                                          wrap="false" />
                                                </Element>
                                                <ProgressBar context="@ProgressTrack(skill)" />
                                                <Element class="wb-skills-row-meta" width="fill" height="16">
                                                    <Text text="@LevelXpText(skill)"
                                                          class="wb-text-small"
                                                          width="fill"
                                                          height="fill"
                                                          wrap="false" />
                                                    <Text text="@TotalXpText(skill.TotalXP)"
                                                          class="wb-skills-total-xp"
                                                          width="fit"
                                                          height="fill"
                                                          wrap="false" />
                                                </Element>
                                            </Element>
                                        </Element>
                                    </ForEach>
                                </Element>
                            </ForEach>
                        </Element>
                    </ScrollArea>
                </Element>

                <Content name="actions">
                    <Element width="fill" height="40" />
                    <Button id="Button_CloseSkills" param:variant="secondary" onclick="OnClose" width="150" height="40">
                        <Text class="wb-button-label" text="@L('ui.button.close')" anchor="Center" />
                    </Button>
                </Content>
            </Modal>
        </Element>
    </Element>
</Reef>
