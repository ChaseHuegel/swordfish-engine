<Reef xmlns="Reef"
      xmlns:param="Reef.Param"
      xmlns:class="Reef.Class"
      xmlns:controls="WaywardBeyond.Client.UI.Controls"
      Class="NewSaveView"
      Context="NewSaveState"
      RendererData="Swordfish.Graphics.Material"
      Namespace="WaywardBeyond.Client.UI.Layers.Menus.Main">

    <Page visible="@(!context.Creating)" param:maxWidth="1160" param:maxHeight="560">
        <Element layout="vertical" width="fill" height="fill" padding="0 12 0 0" spacing="12">

            <Element class="wb-split" class:wb-split-narrow="@(!UsesStandardLayout(ui.Width))" width="fill" height="fill">
                <Element visible="@(!UsesStandardLayout(ui.Width))" layout="horizontal" width="fill" height="40" spacing="8">
                    <Tab id="FormTab" param:selected="@(context.Tab == 0)" onclick="OnSelectTab(0)" width="fill" height="fill">
                        <Text class="wb-tab-label" text="@L('ui.panel.level.form')" width="fill" height="fill" />
                    </Tab>
                    <Tab id="DetailTab" param:selected="@(context.Tab == 1)" onclick="OnSelectTab(1)" width="fill" height="fill">
                        <Text class="wb-tab-label" text="@L('ui.panel.level.form.detail')" width="fill" height="fill" />
                    </Tab>
                </Element>
                <Element visible="@(UsesStandardLayout(ui.Width) || context.Tab == 0)" class="wb-panel wb-split-half" class:wb-split-fill="@(!UsesStandardLayout(ui.Width))" layout="none" height="fill" padding="2">
                    <Element class="wb-panel-inner" layout="vertical" width="fill" height="fill" clip="true" padding="20">
                        <Text text="@L('ui.panel.level.form')" class="wb-panel-header" width="fill" height="18" />
                        <Element height="4" />
                        <Element class="wb-divider-inner" width="fill" height="1" />
                        <Element height="8" />
                        <Text text="@L('ui.text.level.form.hint')" class="wb-text-small" width="fill" height="18" />
                        <Element height="16" />
                        <FormField width="fill">
                            <Content name="label">
                                <Text text="@L('ui.field.level.name')" class="wb-field-label" width="fill" height="16" />
                            </Content>
                            <Element layout="horizontal" width="fill" height="32" spacing="8">
                                <controls:TextInput id="TextBox_SaveName"
                                                    bind="NameState"
                                                    input-service="@Input"
                                                    placeholder="@L('ui.field.level.name.placeholder')"
                                                    class="wb-field-frame"
                                                    width="fill"
                                                    height="fill"
                                                    font-size="18" />
                                <IconButton id="Button_RandomSaveName"
                                            anchor="Center"
                                            param:glyph="dice"
                                            param:size="32"
                                            param:glyphSize="20"
                                            onclick="OnRandomName" />
                            </Element>
                        </FormField>
                        <Element height="16" />
                        <FormField width="fill">
                            <Content name="label">
                                <Text text="@L('ui.field.level.seed')" class="wb-field-label" width="fill" height="16" />
                            </Content>
                            <Element layout="horizontal" width="fill" height="32" spacing="8">
                                <controls:TextInput id="TextBox_SaveSeed"
                                                    bind="SeedState"
                                                    input-service="@Input"
                                                    placeholder="@L('ui.field.level.seed.placeholder')"
                                                    class="wb-field-frame"
                                                    width="fill"
                                                    height="fill"
                                                    font-size="18" />
                                <IconButton id="Button_RandomSeed"
                                            anchor="Center"
                                            param:glyph="dice"
                                            param:size="32"
                                            param:glyphSize="20"
                                            onclick="OnRandomSeed" />
                            </Element>
                        </FormField>
                    </Element>
                </Element>
                <Element visible="@(UsesStandardLayout(ui.Width) || context.Tab == 1)" class="wb-panel wb-split-fill" layout="none" height="fill" padding="2">
                    <Element class="wb-panel-inner" layout="vertical" width="fill" height="fill" clip="true" padding="20">
                        <Text text="@L('ui.panel.level.form.detail')" class="wb-panel-header" width="fill" height="18" />
                        <Element height="4" />
                        <Element class="wb-divider-inner" width="fill" height="1" />
                        <Element height="8" />
                        <Text text="@DisplayName(context.Name)" class="wb-text-title" width="fill" height="26" />
                        <Element height="8" />
                        <Text text="@ModeLine()" class="wb-text-small" width="fill" height="18" />
                        <Text text="@Labeled('ui.label.level.seed', DisplaySeed(context.Seed))" class="wb-text-small" width="fill" height="18" />
                        <Text text="@Labeled('ui.label.level.type', L('ui.label.level.type.asteroids'))" class="wb-text-small" width="fill" height="18" />
                        <Element height="16" />
                        <Element class="wb-divider" width="fill" height="1" />
                    </Element>
                </Element>
            </Element>

            <PageFooter width="fill" height="52">
                <Content name="back">
                    <Button id="Button_Cancel"
                        param:variant="secondary"
                        onclick="OnCancel"
                        anchor="Center"
                        width="170"
                        height="40">
                        <Text class="wb-button-label" text="@L('ui.button.cancel')" anchor="Center" />
                    </Button>
                </Content>
                <Content name="status">
                    <Text visible="@(context.StatusKey != '')"
                        text="@L(context.StatusKey)"
                        class="wb-text-small"
                        class:wb-text-danger-solid="@context.StatusDanger"
                        class:wb-text-warning="@context.StatusWarning"
                        width="fill"
                        height="fill"
                        text-align="center"
                        vertical-align="middle" />
                </Content>
                <Content name="primary">
                    <Button id="Button_Create"
                        param:variant="primary"
                        param:enabled="@context.CanCreate"
                        disabled="@(!context.CanCreate)"
                        onclick="OnCreate"
                        anchor="Center"
                        width="220"
                        height="40">
                        <Text class="wb-button-label" text="@L('ui.button.level.create')" anchor="Center" />
                    </Button>
                </Content>
            </PageFooter>
        </Element>
    </Page>

    <Page visible="@context.Creating" param:maxWidth="600" param:maxHeight="560">
        <Panel width="fill" height="fill">
            <Content name="header">
                <Text text="@L('ui.panel.level.form')" class="wb-panel-header" width="fill" height="18" />
            </Content>
            <Element layout="vertical" width="fill" height="fill" padding="28">
                <Element layout="vertical" width="480" height="fill" anchor="Center">
                    <Text text="@L('ui.label.level.creating')" class="wb-text-body" width="fill" height="24" />
                    <Element height="8" />

                    <ForEach in="@context.Lines" as="line">
                        <Element layout="horizontal" width="fill" height="24" spacing="2">
                            <Text text="&gt;"
                                  class="wb-text-small"
                                  color="@FadeAccent(line.Age)"
                                  width="12"
                                  height="fill" />
                            <Text text="@line.Text"
                                  class="wb-text-small"
                                  color="@FadeMuted(line.Age)"
                                  width="fill"
                                  height="fill" />
                        </Element>
                    </ForEach>

                    <Element layout="horizontal" width="fill" height="24" spacing="2">
                        <Text text="&gt;" class="wb-text-small wb-text-accent" width="12" height="fill" />
                        <Element class="wb-caret-block"
                                 visible="@CursorOn(context.CreateElapsed)"
                                 anchor="Center"
                                 width="8"
                                 height="12" />
                    </Element>

                    <Element height="fill" />
                    <Element class="wb-divider" width="fill" height="1" />
                </Element>
            </Element>
        </Panel>
    </Page>
</Reef>
