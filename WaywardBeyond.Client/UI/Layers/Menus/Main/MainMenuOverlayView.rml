<Reef xmlns="Reef"
      Class="MainMenuOverlayView"
      RendererData="Swordfish.Graphics.Material"
      Namespace="WaywardBeyond.Client.UI.Layers.Menus.Main">

    <Element layout="none" width="100%" height="100%" padding="20" passthrough="true">
        <Element id="Button_Feedback"
                 class="wb-button wb-button-compact"
                 onclick="OnFeedback"
                 width="fit"
                 height="fit"
                 anchor="Bottom Left">
            <Text class="wb-button-label" text="@L('ui.button.feedback.send')" />
        </Element>

        <Element layout="horizontal"
                 width="88"
                 height="40"
                 spacing="8"
                 anchor="Bottom Right">
            <Element id="Button_Discord"
                     class="wb-icon-button"
                     onclick="OnDiscord"
                     width="40"
                     height="40">
                <Text class="wb-icon-brand" text="@Glyph('discord')" width="fill" height="fill" />
            </Element>
            <Element id="Button_Steam"
                     class="wb-icon-button"
                     onclick="OnSteam"
                     width="40"
                     height="40">
                <Text class="wb-icon-brand" text="@Glyph('steam')" width="fill" height="fill" />
            </Element>
        </Element>
    </Element>
</Reef>
