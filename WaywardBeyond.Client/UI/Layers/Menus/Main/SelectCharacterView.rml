<Reef xmlns="Reef"
      xmlns:param="Reef.Param"
      xmlns:class="Reef.Class"
      Class="SelectCharacterView"
      Context="SelectCharacterState"
      RendererData="Swordfish.Graphics.Material"
      Namespace="WaywardBeyond.Client.UI.Layers.Menus.Main">

    <Page param:maxWidth="1160" param:maxHeight="560">
        <Element layout="vertical" width="fill" height="fill" padding="0 12 0 0" spacing="12">

            <Element class="wb-split" class:wb-split-narrow="@(!UsesStandardLayout(ui.Width))" width="fill" height="fill">
                <Element visible="@(!UsesStandardLayout(ui.Width))" layout="horizontal" width="fill" height="40" spacing="8">
                    <Tab id="ManifestTab" param:selected="@(context.Tab == 0)" onclick="OnSelectTab(0)" width="fill" height="fill">
                        <Text class="wb-tab-label" text="@L('ui.panel.character.list')" width="fill" height="fill" />
                    </Tab>
                    <Tab id="DetailTab" param:selected="@(context.Tab == 1)" onclick="OnSelectTab(1)" width="fill" height="fill">
                        <Text class="wb-tab-label" text="@L('ui.panel.character.detail')" width="fill" height="fill" />
                    </Tab>
                </Element>
                <Panel class="wb-split-third" class:wb-split-fill="@(!UsesStandardLayout(ui.Width))" visible="@(UsesStandardLayout(ui.Width) || context.Tab == 0)" height="fill">
                    <Content name="header">
                        <Text text="@L('ui.panel.character.list')" class="wb-panel-header" width="fill" height="18" />
                    </Content>
                    <Element layout="vertical" width="fill" height="fill">
                        <Text visible="@(!context.HasCharacters)"
                              text="@L('ui.label.none')"
                              class="wb-text-body wb-text-dim"
                              width="fill"
                              height="fill"
                              text-align="center"
                              vertical-align="middle" />
                        <ScrollArea id="SelectCharacter.Manifest"
                                    context="@Scroll"
                                    visible="@context.HasCharacters"
                                    width="fill"
                                    height="fill">
                            <Element id="SelectCharacter.ManifestContent" layout="vertical" width="fill" height="fit" spacing="8">
                                <ForEach in="@context.Characters" as="crew">
                                    <Card param:selected="@crew.Selected"
                                             id="Button_SelectCharacter_{crew.Uuid}"
                                             onclick="OnSelectCharacter(crew.Uuid)"
                                             width="fill"
                                             height="44">
                                        <Element layout="horizontal"
                                                 width="fill"
                                                 height="fill"
                                                 padding="8 0 8 0"
                                                 spacing="8">
                                            <Image source="@crew.Portrait" width="32" height="32" />
                                            <Text text="@crew.Name"
                                                  class="wb-text-body"
                                                  class:wb-text-accent="@crew.Selected"
                                                  width="fill"
                                                  height="fill" />
                                            <IconButton id="Button_DeleteCharacter_{crew.Uuid}"
                                                        anchor="Center"
                                                        param:glyph="trash"
                                                        param:tone="danger"
                                                        param:size="28"
                                                        param:glyphSize="20"
                                                        onclick="OnDeleteCharacter(crew.Uuid)" />
                                        </Element>
                                    </Card>
                                </ForEach>
                            </Element>
                        </ScrollArea>

                        <Element height="8" />
                        <Button id="Button_NewCharacter"
                                param:variant="subtle"
                                param:doubleBorder="false"
                                onclick="OnNewCharacter"
                                width="fill"
                                height="32">
                            <Text class="wb-button-label" text="@('+ ' + L('ui.button.character.new'))" anchor="Center" />
                        </Button>
                    </Element>
                </Panel>
                <Panel class="wb-split-fill" visible="@(UsesStandardLayout(ui.Width) || context.Tab == 1)" height="fill">
                    <Content name="header">
                        <Text text="@L('ui.panel.character.detail')" class="wb-panel-header" width="fill" height="18" />
                    </Content>
                    <Text visible="@(!context.HasActive)"
                          text="@L('ui.label.none')"
                          class="wb-text-body wb-text-dim"
                          width="fill"
                          height="fill"
                          text-align="center"
                          vertical-align="middle" />
                    <Element visible="@context.HasActive" layout="vertical" width="fill" height="fill">
                        <Text text="@context.Detail.Name" class="wb-text-title" width="fill" height="26" />
                        <Text text="@LevelLine(context.Detail.Level, context.Detail.Species)" class="wb-text-small wb-text-accent" width="fill" height="18" text-align="center" />
                        <Text text="@Labeled('ui.label.lastPlayed', LastPlayedText(context.Detail.LastPlayedMs))" class="wb-text-small" width="fill" height="18" text-align="center" />
                        <Text text="@Labeled('ui.label.timePlayed', TimePlayedText(context.Detail.AgeMs))" class="wb-text-small" width="fill" height="18" text-align="center" />

                        <Element height="16" />
                        <Element layout="horizontal" width="fill" height="128" spacing="20">
                            <Image source="@context.Detail.Portrait" width="128" height="128" />
                            <Element layout="vertical" width="fill" height="fill" padding="0 0 40 0">
                                <ForEach in="@context.Detail.Stats" as="stat">
                                    <Element layout="horizontal" width="30%" height="18">
                                        <Text text="@StatText(stat.LabelKey)" class="wb-text-small" width="fill" height="fill" wrap="false" />
                                        <Text text="@stat.Value" class="wb-text-value" width="28" height="fill" text-align="right" />
                                    </Element>
                                </ForEach>
                            </Element>
                        </Element>

                        <Element visible="@(UsesTallLayout(ui.Height))" height="16" />
                        <Element visible="@(UsesTallLayout(ui.Height))" class="wb-divider" width="fill" height="1" />
                        <Element visible="@(UsesTallLayout(ui.Height))" height="8" />
                        <Text visible="@(UsesTallLayout(ui.Height))"
                              text="@L('ui.label.character.assignment')"
                              class="wb-text-small"
                              width="fill"
                              height="18" />
                        <Text visible="@(UsesTallLayout(ui.Height))"
                              text="@AssignmentText(context.Detail.Assignment)"
                              class="wb-text-body"
                              width="fill"
                              height="22" />

                        <Element height="fill" />
                        <Element class="wb-divider" width="fill" height="1" />
                        <Element height="8" />
                        <Text text="@L('ui.label.character.ready')" class="wb-text-small wb-text-success" width="fill" height="20" />
                    </Element>
                </Panel>
            </Element>

            <PageFooter width="fill" height="52">
                <Content name="back">
                    <Button id="Button_Back"
                        param:variant="secondary"
                        onclick="OnBack"
                        anchor="Center"
                        width="170"
                        height="40">
                        <Text class="wb-button-label" text="@L('ui.button.back')" anchor="Center" />
                    </Button>
                </Content>
                <Content name="primary">
                    <Button id="Button_LoadSave"
                        param:variant="primary"
                        param:enabled="@context.CanLaunch"
                        disabled="@(!context.CanLaunch)"
                        onclick="OnLaunch"
                        anchor="Center"
                        width="220"
                        height="40">
                        <Text class="wb-button-label" text="@L('ui.button.level.launch')" anchor="Center" />
                    </Button>
                </Content>
            </PageFooter>
        </Element>
    </Page>
</Reef>
