<Reef xmlns="Reef"
      xmlns:param="Reef.Param"
      xmlns:class="Reef.Class"
      xmlns:s="WaywardBeyond.Client.UI.Settings"
      Class="SettingsRowsView"
      Context="SettingsRowsState"
      RendererData="Swordfish.Graphics.Material"
      Namespace="WaywardBeyond.Client.UI.Layers.Menus">

    <ScrollArea id="Settings.Rows" context="@Scroll" width="fill" height="fill">
        <Element id="Settings.RowsContent" layout="vertical" width="fill" height="fit">
            <ForEach in="@context.Rows" as="row">
                <If condition="@row.IsSection">
                    <Text text="@row.Label" class="wb-settings-section" width="fill" height="35" />
                    <Element class="wb-divider-inner" width="fill" height="1" />
                </If>

                <ElseIf condition="@row.IsChoice">
                <Element layout="horizontal" width="fill" height="44" spacing="16" clip="true">
                    <Text text="@row.Label"
                          wrap="false"
                          class="wb-settings-label"
                          class:wb-text-dim="@(!row.Enabled)"
                          width="fill"
                          height="fill" />
                    <s:SettingsChoice id="@row.Id"
                                      options="@row.Options"
                                      value="@row.Index"
                                      enabled="@row.Enabled"
                                      onChanged="OnChoiceChanged"
                                      width="@context.ControlWidth"
                                      height="32"
                                      anchor="Center" />
                </Element>
                </ElseIf>

                <ElseIf condition="@row.IsStepper">
                <Element layout="horizontal" width="fill" height="44" spacing="16" clip="true">
                    <Text text="@row.Label"
                          wrap="false"
                          class="wb-settings-label"
                          class:wb-text-dim="@(!row.Enabled)"
                          width="fill"
                          height="fill" />
                    <Element class="wb-stepper"
                             class:wb-stepper-enabled="@row.Enabled"
                             layout="none"
                             width="@context.ControlWidth"
                             height="32"
                             anchor="Center"
                             padding="1"
                             clip="true">
                        <Element class="wb-stepper-inner" layout="horizontal" width="fill" height="fill">
                            <Element class="wb-stepper-arrow"
                                     class:wb-stepper-arrow-enabled="@(row.Enabled &amp;&amp; row.CanDecrease)"
                                     id="{row.Id}.previous"
                                     disabled="@(!row.Enabled || !row.CanDecrease)"
                                     onclick="OnStep(row.Id, -1)"
                                     width="32"
                                     height="fill">
                                <Text text="&lt;" class="wb-stepper-arrow-glyph" width="fill" height="fill" />
                            </Element>
                            <Element class="wb-stepper-sep" width="1" height="fill" />
                            <Text text="@row.Value"
                                  class="wb-stepper-value"
                                  class:wb-stepper-value-enabled="@row.Enabled"
                                  width="fill"
                                  height="fill" />
                            <Element class="wb-stepper-sep" width="1" height="fill" />
                            <Element class="wb-stepper-arrow"
                                     class:wb-stepper-arrow-enabled="@(row.Enabled &amp;&amp; row.CanIncrease)"
                                     id="{row.Id}.next"
                                     disabled="@(!row.Enabled || !row.CanIncrease)"
                                     onclick="OnStep(row.Id, 1)"
                                     width="32"
                                     height="fill">
                                <Text text="&gt;" class="wb-stepper-arrow-glyph" width="fill" height="fill" />
                            </Element>
                        </Element>
                    </Element>
                </Element>
                </ElseIf>

                <ElseIf condition="@row.IsSlider">
                <Element layout="horizontal" width="fill" height="44" spacing="16" clip="true">
                    <Text text="@row.Label"
                          wrap="false"
                          class="wb-settings-label"
                          class:wb-text-dim="@(!row.Enabled)"
                          width="fill"
                          height="fill" />
                    <s:SettingsSlider id="@row.Id"
                                      value="@row.SliderValue"
                                      min="@row.Min"
                                      max="@row.Max"
                                      step="@row.Step"
                                      display="@row.Display"
                                      enabled="@row.Enabled"
                                      onChanged="OnSliderChanged"
                                      width="@context.ControlWidth"
                                      height="32"
                                      anchor="Center" />
                </Element>
                </ElseIf>

                <ElseIf condition="@row.IsReset">
                <Element class="wb-divider-inner" width="fill" height="1" />
                <Element height="4" />
                <Element class="wb-button wb-button-danger"
                         id="{row.Id}"
                         layout="none"
                         clip="true"
                         onclick="OnReset(row.Id)"
                         width="fill"
                         height="36">
                    <Element class="wb-button-inner wb-button-inner-danger" layout="none" width="fill" height="fill" />
                    <Text class="wb-button-label" text="@L('ui.settings.action.reset')" anchor="Center" />
                </Element>
                <Element height="3" />
                </ElseIf>
            </ForEach>
        </Element>
    </ScrollArea>
</Reef>
