:root {
    --wb-playtest-scrim: #000000f2;
    --wb-playtest-panel: #111723f0;
    --wb-playtest-text: #f0f3f6;
    --wb-playtest-border: #2b384e;
    --wb-playtest-primary: #f2994a;
    --wb-playtest-primary-bright: #ffd27d;
    --wb-playtest-primary-dark: #3d2614;
    --wb-playtest-button: #121826;
    --wb-playtest-button-hover: #1b2538;
    --wb-playtest-accent-dark: #162838;
    --wb-playtest-text-muted: #8da0b8;
}

.playtest-scrim {
    background-color: var(--wb-playtest-scrim);
}

.playtest-center {
    padding: 80px;
}

.playtest-panel {
    background-color: var(--wb-playtest-panel);
    border-radius: 4px;
    padding: 28px;
}

.playtest-title {
    color: var(--wb-playtest-text);
    font-family: "Salmon Mono 9 Regular";
    font-size: 24px;
    text-align: center;
}

.playtest-divider {
    background-color: var(--wb-playtest-border);
}

.playtest-body {
    color: var(--wb-playtest-text);
    font-size: 18px;
}

.playtest-row {
    gap: 8px;
}

.playtest-button-base {
    border-radius: 4px;
    padding: 8px 16px;
}

.playtest-brand-button {
    --extends: playtest-button-base;
    background-color: transparent;
    padding: 0;
}

.playtest-brand-button:hover {
    background-color: var(--wb-playtest-button-hover);
}

.playtest-brand-button:active {
    background-color: var(--wb-playtest-accent-dark);
}

.playtest-brand-glyph {
    color: var(--wb-playtest-text-muted);
    font-family: "Font Awesome 6 Free Brands";
    font-size: 32px;
    text-align: center;
    vertical-align: middle;
}

.playtest-primary-button {
    --extends: playtest-button-base;
    background-color: var(--wb-playtest-button);
    border: 1px var(--wb-playtest-primary);
    corner-caps: 6 1 var(--wb-playtest-primary);
}

.playtest-primary-button:hover {
    background-color: var(--wb-playtest-button-hover);
    border-color: var(--wb-playtest-primary-bright);
    corner-caps-color: var(--wb-playtest-primary-bright);
}

.playtest-primary-button:active {
    background-color: var(--wb-playtest-primary-dark);
}

.playtest-primary-label {
    color: var(--wb-playtest-primary-bright);
    font-size: 18px;
    text-align: center;
    vertical-align: middle;
}
