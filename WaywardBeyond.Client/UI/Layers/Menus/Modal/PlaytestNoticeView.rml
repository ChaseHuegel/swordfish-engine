<Reef xmlns="Reef"
      Class="PlaytestNoticeView"
      RendererData="Swordfish.Graphics.Material"
      Namespace="WaywardBeyond.Client.UI.Layers.Menus.Modal">

    <Element id="PlaytestNoticeScrim" class="wb-scrim-heavy" layout="none" width="100%" height="100%">
        <Element class="wb-modal-center" layout="none" width="100%" height="100%" clip="true">
            <Element id="PlaytestNoticePanel"
                     layout="vertical"
                     class="wb-modal wb-modal-playtest"
                     clip="true">

                <Text text="@L('ui.dialog.playtest')"
                      class="wb-modal-title"
                      width="fill"
                      height="30" />

                <Element height="8" />
                <Element class="wb-divider" width="fill" height="1" />
                <Element height="16" />

                <Text text="@L('ui.dialog.playtest.body')"
                      class="wb-modal-body"
                      width="fill"
                      height="fill"
                      wrap="true" />

                <Element layout="horizontal" class="wb-row" width="fill" height="40">
                    <Element id="Button_Community"
                             class="wb-icon-button"
                             onclick="OnDiscord"
                             width="40"
                             height="40">
                        <Text text="@Glyph('discord')"
                              class="wb-icon-brand"
                              width="fill"
                              height="fill" />
                    </Element>

                    <Element id="Button_Wishlist"
                             class="wb-icon-button"
                             onclick="OnSteam"
                             width="40"
                             height="40">
                        <Text text="@Glyph('steam')"
                              class="wb-icon-brand"
                              width="fill"
                              height="fill" />
                    </Element>

                    <Element width="fill" />

                    <Element id="Button_Close"
                             class="wb-button wb-button-primary"
                             onclick="OnClose"
                             width="200"
                             height="40">
                        <Text text="@L('ui.button.ok')"
                              class="wb-button-label"
                              width="fill"
                              height="fill" />
                    </Element>
                </Element>
            </Element>
        </Element>
    </Element>
</Reef>
