    --wb-accent-dark: #162838;
    --wb-primary: #f2994a;
    --wb-primary-bright: #ffd27d;
    --wb-primary-dark: #3d2614;
    --wb-danger: #e04f7a;
    --wb-danger-bright: #ff8da6;
    --wb-danger-dark: #3d141e;
    --wb-success: #6fcf97;
    --wb-warning: #f2cc4a;

