:root {
    --wb-font-ui: "Salmon Mono 9 Regular";
    --wb-font-icons: "Font Awesome 6 Free Solid";
    --wb-font-brands: "Font Awesome 6 Free Brands";

    --wb-text: #f0f3f6;
    --wb-text-muted: #8da0b8;
    --wb-text-dim: #45546b;
    --wb-text-soft: #bfbfbf;

    --wb-panel: #111723f0;
