<Reef xmlns="Reef"
      Class="ScrollBar"
      Access="internal"
      Context="ScrollBarState"
      RendererData="Swordfish.Graphics.Material"
      Namespace="WaywardBeyond.Client.UI.Components">
    <Element class="wb-scrollbar" layout="none" width="6" height="fill" clip="true">
        <Element class="wb-scrollbar-thumb"
                 visible="@context.HasThumb"
                 width="fill"
                 height="@context.ThumbHeight"
                 y="@context.ThumbY" />
        <Element visible="@context.HasThumb"
                 layout="none"
                 width="fill"
                 height="fill"
                 onclick="@context.OnPress(ui.GetRelativeCursorPosition().Y, ui.GetElementBounds().Rect.Size.Y)"
                 onheld="@context.OnHeld(ui.GetRelativeCursorPosition().Y, ui.GetElementBounds().Rect.Size.Y)" />
    </Element>
</Reef>
