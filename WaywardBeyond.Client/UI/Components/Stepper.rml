<Reef xmlns="Reef"
      xmlns:class="Reef.Class"
      Class="Stepper"
      Access="internal"
      Parameters="StepperParameters"
      RendererData="Swordfish.Graphics.Material"
      Namespace="WaywardBeyond.Client.UI.Components">
    <Element class="wb-stepper" layout="none" padding="1" clip="true">
        <Element class="wb-stepper-inner" layout="horizontal" width="fill" height="fill">
            <Element class="wb-stepper-arrow"
                     class:wb-stepper-arrow-enabled="@param.Enabled"
                     disabled="@(!param.Enabled)"
                     onclick="@param.OnDecrease"
                     width="32"
                     height="fill">
                <Text text="&lt;"
                      class="wb-stepper-arrow-glyph"
                      width="fill"
                      height="fill" />
            </Element>
            <Element class="wb-stepper-sep" width="1" height="fill" />
            <Text text="@param.Value"
                  class="wb-stepper-value"
                  class:wb-stepper-value-enabled="@param.Enabled"
                  width="fill"
                  height="fill" />
            <Element class="wb-stepper-sep" width="1" height="fill" />
            <Element class="wb-stepper-arrow"
                     class:wb-stepper-arrow-enabled="@param.Enabled"
                     disabled="@(!param.Enabled)"
                     onclick="@param.OnIncrease"
                     width="32"
                     height="fill">
                <Text text="&gt;"
                      class="wb-stepper-arrow-glyph"
                      width="fill"
                      height="fill" />
            </Element>
        </Element>
    </Element>
</Reef>
