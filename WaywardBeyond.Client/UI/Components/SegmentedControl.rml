<Reef xmlns="Reef"
      xmlns:param="Reef.Param"
      xmlns:class="Reef.Class"
      Class="SegmentedControl"
      Access="internal"
      Parameters="SegmentedControlParameters"
      RendererData="Swordfish.Graphics.Material"
      Namespace="WaywardBeyond.Client.UI.Components">
    <Element class="wb-choice"
             class:wb-choice-disabled="@(!param.Enabled)"
             layout="none"
             clip="true">
        <Element class="wb-choice-row"
                 layout="horizontal"
                 width="fill"
                 height="fill"
                 spacing="1">
            <ForEach in="@param.Options" as="option" index="i">
                <Element class="wb-choice-cell"
                         class:wb-choice-cell-selected="@(i == param.Selected &amp;&amp; param.Enabled)"
                         class:wb-choice-cell-disabled="@(!param.Enabled)"
                         id="@(param.Id + '.' + i)"
                         disabled="@(i == param.Selected || !param.Enabled)"
                         onclick="@param.OnSelect(param.Id, i)"
                         width="fill"
                         height="fill">
                    <Text class="wb-choice-label"
                          text="@option"
                          wrap="false"
                          width="fill"
                          height="fill" />
                </Element>
            </ForEach>
        </Element>
    </Element>
</Reef>
