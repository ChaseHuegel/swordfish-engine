<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <Version>0.1.0-alpha</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!--  Modules carry a <manifest.toml>; when published alongside transitively-referenced modules the
              copied manifests collide in publish output. Mirrors the module-publish duplicate suppression in
              Shoal.Build.targets. -->
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="assets\**\*.*" Exclude="assets\lang\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest"/>
        <Content Include="assets\lang\**\*" CopyToOutputDirectory="PreserveNewest"/>
        <EmbeddedResource Include="manifest\**\*.*" />
        <None Update="manifest.toml">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SmartFormat.NET" Version="3.6.1" />
        <ProjectReference Include="..\Swordfish\Swordfish.csproj" Private="false" ExcludeAssets="runtime" IncludeAssets="compile"/>
        <ProjectReference Include="..\WaywardBeyond.Data\WaywardBeyond.Data.csproj" />
        <ProjectReference Include="..\WaywardBeyond.Bricks\WaywardBeyond.Bricks.csproj" Private="false" ExcludeAssets="runtime" IncludeAssets="compile" />
        <ProjectReference Include="..\WaywardBeyond.Items\WaywardBeyond.Items.csproj" Private="false" ExcludeAssets="runtime" IncludeAssets="compile" />
        <ProjectReference Include="..\WaywardBeyond.Recipes\WaywardBeyond.Recipes.csproj" Private="false" ExcludeAssets="runtime" IncludeAssets="compile" />
        <ProjectReference Include="..\WaywardBeyond.Bodies\WaywardBeyond.Bodies.csproj" Private="false" ExcludeAssets="runtime" IncludeAssets="compile" />
        <ProjectReference Include="..\WaywardBeyond.Gameplay\WaywardBeyond.Gameplay.csproj" />
        <ProjectReference Include="..\WaywardBeyond.Meshing\WaywardBeyond.Meshing.csproj" />
        <ProjectReference Include="..\WaywardBeyond.Voxels\WaywardBeyond.Voxels.csproj" />
        <ProjectReference Include="..\WaywardBeyond.Skills\WaywardBeyond.Skills.csproj" Private="false" ExcludeAssets="runtime" IncludeAssets="compile" />
    <ProjectReference Include="..\WaywardBeyond.Networking\WaywardBeyond.Networking.csproj" />
        <ProjectReference Include="..\WaywardBeyond.Server\WaywardBeyond.Server.csproj" Private="false" ExcludeAssets="runtime" IncludeAssets="compile" />
        <PackageReference Include="HardwareInformation" Version="5.0.2" />
        <!--  HardwareInformation pulls VulkanSharp, which targets netstandard1.1 and brings vulnerable framework packages.  -->
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
        <ProjectReference Include="..\Reef\Reef.csproj" />
        <ProjectReference Include="..\Reef.Generator\Reef.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Import Project="..\Reef.Generator\build\Reef.Generator.props" />

</Project>
