<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Swordfish Launcher</AssemblyName>
        <OutputType>Exe</OutputType>
        <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>resources/swordfish.ico</ApplicationIcon>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Swordfish\Swordfish.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="resources\swordfish.ico" />
    </ItemGroup>

    <ItemGroup>
      <None Update="assets\config\modules.toml">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="assets\config\logging.toml">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <!--
        The launcher owns assets/config. A referenced module ships its own copy of the launcher
        config, so both files map to the same output path. Keep the launcher's copy and drop the
        module's, otherwise the publish step fails with NETSDK1152.
    -->
    <Target Name="_ExcludeModuleConfigFromLauncherRootOutput"
            BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;_CopyOutOfDateSourceItemsToOutputDirectoryAlways;_CopyDifferingSourceItemsToOutputDirectory">
        <PropertyGroup>
            <_LauncherProjectRoot>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))</_LauncherProjectRoot>
        </PropertyGroup>
        <ItemGroup>
            <_ModuleConfigOutput Include="@(_SourceItemsToCopyToOutputDirectory);@(_SourceItemsToCopyToOutputDirectoryAlways);@(_SourceItemsToCopyToOutputDirectoryIfDifferent)"
                                 Condition="($([System.String]::Copy('%(TargetPath)').StartsWith('assets\config\', System.StringComparison.OrdinalIgnoreCase))
                                             or $([System.String]::Copy('%(TargetPath)').StartsWith('assets/config/', System.StringComparison.OrdinalIgnoreCase)))
                                            and !$([System.String]::Copy('%(FullPath)').StartsWith('$(_LauncherProjectRoot)', System.StringComparison.OrdinalIgnoreCase))" />
            <_SourceItemsToCopyToOutputDirectory Remove="@(_ModuleConfigOutput)" />
            <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_ModuleConfigOutput)" />
            <_SourceItemsToCopyToOutputDirectoryIfDifferent Remove="@(_ModuleConfigOutput)" />
        </ItemGroup>
    </Target>

    <Target Name="_ExcludeModuleConfigFromLauncherRootPublish"
            AfterTargets="ComputeFilesToPublish"
            BeforeTargets="_HandleFileConflictsForPublish;_GetCurrentAndPriorPublishFileWrites;_ComputeResolvedFilesToPublishTypes">
        <PropertyGroup>
            <_LauncherProjectRoot>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))</_LauncherProjectRoot>
        </PropertyGroup>
        <ItemGroup>
            <_ModuleConfigPublish Include="@(ResolvedFileToPublish)"
                                  Condition="($([System.String]::Copy('%(RelativePath)').StartsWith('assets\config\', System.StringComparison.OrdinalIgnoreCase))
                                              or $([System.String]::Copy('%(RelativePath)').StartsWith('assets/config/', System.StringComparison.OrdinalIgnoreCase)))
                                             and !$([System.String]::Copy('%(FullPath)').StartsWith('$(_LauncherProjectRoot)', System.StringComparison.OrdinalIgnoreCase))" />
            <ResolvedFileToPublish Remove="@(_ModuleConfigPublish)" />
        </ItemGroup>
    </Target>

</Project>
