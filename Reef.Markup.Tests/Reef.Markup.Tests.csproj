<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>13</LangVersion>
    <RollForward>LatestMajor</RollForward>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reef\Reef.csproj" />
    <ProjectReference Include="..\Reef.Markup.TestComponents\Reef.Markup.TestComponents.csproj" />
    <ProjectReference Include="..\Reef.Generator\Reef.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\Reef.Generator\build\Reef.Generator.props" />

  <ItemGroup>
    <None Include="..\Reef.Tests\TestFiles\Fonts\*.*"
          Link="TestFiles\Fonts\%(Filename)%(Extension)"
          CopyToOutputDirectory="Always" />
    <None Include="..\Reef.Tests\TestFiles\Images\swordfish.png"
          Link="TestFiles\Images\swordfish.png"
          CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
