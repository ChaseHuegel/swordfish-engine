:root {
    --base: #101010;
    --panel: #202020;
    --hover: #303030;
    --active: #404040;
    --disabled: #505050;
}

.base {
    background: var(--base);
    padding: 4;
    corner-radius: 4;
}

.panel : .base {
    background: var(--panel);
    border: 1 #606060;
}

.panel {
    padding: 8;
}

.panel:hover {
    background: var(--hover);
}

.panel:active {
    background: var(--active);
}

.panel:disabled {
    background: var(--disabled);
}

.accent {
    color: #ffff00;
}

.radius-test {
    background: #182028;
}

.order-a {
    color: #ff0000;
}

.order-b {
    color: #00ff00;
}
