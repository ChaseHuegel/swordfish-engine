<Reef xmlns="Reef"
      Class="OverlayView"
      Context="OverlayContext"
      RendererData="Reef.PixelTexture"
      Namespace="Reef.Markup.Tests">
    <Element layout="none" width="300" height="240" background="#050505">
        <Element id="clip_parent" width="100" height="100" clip="true" background="#111111">
            <Element id="clipped" width="200" height="200" background="#ff0000" />
            <Element id="overlay" width="150" height="150" overlay="true" background="#00ff00" />
        </Element>

        <Element id="bottom" onclick="OnBack" width="80" height="40" x="140" y="10" background="#0000ff" />
        <Element id="top" passthrough="true" width="80" height="40" x="140" y="10" background="#00ffff" />

        <Element id="scroll" width="100" height="50" scroll="vertical" clip="true"
                 scroll-y="@context.ScrollY" onscroll="OnScrolled(ui.GetScrollDelta())"
                 x="140" y="70" background="#202020">
            <Element id="scroll_content" width="100" height="200" background="#803030" />
        </Element>

        <Element id="hidden" visible="@context.Hide" width="20" height="20" x="250" y="10" background="#ffffff" />
    </Element>
</Reef>
