<Reef xmlns="Reef"
      Class="ModalView"
      Context="ModalState"
      RendererData="Reef.PixelTexture"
      Namespace="Reef.Markup.Tests">

    <Element layout="none" width="100%" height="100%">
        <ModalDialog context="@context"
                     width="360"
                     background="#222831">
            <Content name="header">
                <Text text="@context.Title" size="20" color="#ffffff" />
            </Content>
            <Text text="Body from caller" color="#d0d0d0" />
            <Content name="actions">
                <Element id="close_button" class="close-button" onclick="OnClose">
                    <Text text="Close" />
                </Element>
            </Content>
        </ModalDialog>
    </Element>

</Reef>
