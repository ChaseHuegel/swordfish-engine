<Project>

    <PropertyGroup>
        <_ShoalGitLfsStamp>$(BaseIntermediateOutputPath)git-lfs-pull.stamp</_ShoalGitLfsStamp>
    </PropertyGroup>

    <Target Name="GitLFSPull"
            BeforeTargets="Build"
            Condition="'$(SkipGitLFSPull)' != 'true' and (!Exists('$(_ShoalGitLfsStamp)') or '$(_IsPublishing)' == 'true')">
        <Exec Command="git lfs pull" />
        <MakeDir Directories="$(BaseIntermediateOutputPath)" Condition="!Exists('$(BaseIntermediateOutputPath)')" />
        <Touch Files="$(_ShoalGitLfsStamp)" AlwaysCreate="true" />
    </Target>

    <Target Name="AllowDuplicatesOnPublish" BeforeTargets="BeforeResolveReferences">
        <PropertyGroup>
            <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
        </PropertyGroup>
    </Target>

    <!-- Prevent module assets and manifest.toml from copying into the launcher root directory -->
    <Target Name="_ExcludeModuleRootOutputFiles"
            BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;_CopyOutOfDateSourceItemsToOutputDirectoryAlways;_CopyDifferingSourceItemsToOutputDirectory">
        <ItemGroup>
            <_ShoalExcludedRootOutput Include="@(_SourceItemsToCopyToOutputDirectory);@(_SourceItemsToCopyToOutputDirectoryAlways);@(_SourceItemsToCopyToOutputDirectoryIfDifferent)"
                                      Condition="'%(TargetPath)' == 'manifest.toml'
                                                 or $([System.String]::Copy('%(TargetPath)').StartsWith('assets\', System.StringComparison.OrdinalIgnoreCase))
                                                 or $([System.String]::Copy('%(TargetPath)').StartsWith('assets/', System.StringComparison.OrdinalIgnoreCase))" />
            <_SourceItemsToCopyToOutputDirectory Remove="@(_ShoalExcludedRootOutput)" MatchOnMetadata="TargetPath" />
            <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_ShoalExcludedRootOutput)" MatchOnMetadata="TargetPath" />
            <_SourceItemsToCopyToOutputDirectoryIfDifferent Remove="@(_ShoalExcludedRootOutput)" MatchOnMetadata="TargetPath" />
        </ItemGroup>
    </Target>

    <Target Name="_ExcludeModuleRootPublishFiles"
            AfterTargets="ComputeFilesToPublish"
            BeforeTargets="_HandleFileConflictsForPublish;_GetCurrentAndPriorPublishFileWrites;_ComputeResolvedFilesToPublishTypes">
        <ItemGroup>
            <_ShoalExcludedRootPublish Include="@(ResolvedFileToPublish)"
                                       Condition="'%(RelativePath)' == 'manifest.toml'
                                                  or $([System.String]::Copy('%(RelativePath)').StartsWith('assets\', System.StringComparison.OrdinalIgnoreCase))
                                                  or $([System.String]::Copy('%(RelativePath)').StartsWith('assets/', System.StringComparison.OrdinalIgnoreCase))" />
            <ResolvedFileToPublish Remove="@(_ShoalExcludedRootPublish)" MatchOnMetadata="RelativePath" />
        </ItemGroup>
    </Target>

    <Target Name="_SetBuildModuleTargetDir">
        <PropertyGroup>
            <ModuleTargetDir>$(TargetDir)</ModuleTargetDir>
        </PropertyGroup>
    </Target>

    <Target Name="_SetPublishModuleTargetDir">
        <PropertyGroup>
            <ModuleTargetDir>$(PublishDir)</ModuleTargetDir>
        </PropertyGroup>
    </Target>

    <Target Name="IncludeModulesOnBuild"
            AfterTargets="Build"
            Condition="'$(_IsPublishing)' != 'true' and '$(SkipShoalModuleStaging)' != 'true'"
            DependsOnTargets="_SetBuildModuleTargetDir;PublishModules" />

    <Target Name="IncludeModulesOnPublish"
            AfterTargets="Publish"
            Condition="'$(SkipShoalModuleStaging)' != 'true'"
            DependsOnTargets="_SetPublishModuleTargetDir;PublishModules" />

    <Target Name="PublishModules">
        <ItemGroup>
            <ModuleProjectReferences Include="@(ProjectReference->HasMetadata('ModulePath'))" />
        </ItemGroup>

        <PropertyGroup>
            <_ResolvedModuleTargetDir Condition="'$(ModuleTargetDir)' != ''">$(ModuleTargetDir)</_ResolvedModuleTargetDir>
            <_ResolvedModuleTargetDir Condition="'$(_ResolvedModuleTargetDir)' == '' and '$(_IsPublishing)' == 'true'">$(PublishDir)</_ResolvedModuleTargetDir>
            <_ResolvedModuleTargetDir Condition="'$(_ResolvedModuleTargetDir)' == ''">$(TargetDir)</_ResolvedModuleTargetDir>
            <AbsoluteModuleTargetDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(_ResolvedModuleTargetDir)'))</AbsoluteModuleTargetDir>
            <ModulesRoot>$(AbsoluteModuleTargetDir)modules/</ModulesRoot>
        </PropertyGroup>

        <ItemGroup>
            <_ModuleProjectsToPublish Include="@(ModuleProjectReferences)">
                <AdditionalProperties>PublishDir=$(ModulesRoot)%(ModuleProjectReferences.ModulePath)/;NoBuild=true;SelfContained=false;RuntimeIdentifier=;CopyLocalRuntimeTargetAssets=false</AdditionalProperties>
            </_ModuleProjectsToPublish>
        </ItemGroup>

        <!-- Publish module projects in parallel without rebuilding their already-built graphs -->
        <MSBuild Projects="@(_ModuleProjectsToPublish)" Targets="Publish" BuildInParallel="true" />

        <!-- Clean up any leftover runtimes, root manifest, or root assets from earlier builds -->
        <ItemGroup>
            <_StaleModuleRuntimes Include="@(ModuleProjectReferences->'$(ModulesRoot)%(ModulePath)/runtimes')"
                                  Condition="Exists('$(ModulesRoot)%(ModulePath)/runtimes')" />
        </ItemGroup>
        <RemoveDir Directories="@(_StaleModuleRuntimes)" Condition="'@(_StaleModuleRuntimes)' != ''" />
        <Delete Files="$(AbsoluteModuleTargetDir)manifest.toml" Condition="Exists('$(AbsoluteModuleTargetDir)manifest.toml')" />
        <RemoveDir Directories="$(AbsoluteModuleTargetDir)assets/" Condition="Exists('$(AbsoluteModuleTargetDir)assets/')" />
    </Target>

</Project>
