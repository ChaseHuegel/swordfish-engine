<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WaywardBeyond.AssetStudio.Models"
             xmlns:conv="clr-namespace:WaywardBeyond.AssetStudio.Converters"
             x:Class="WaywardBeyond.AssetStudio.Controls.BodySpritePickerControl">
  <Grid>
    <Grid x:Name="PART_InputRow" ColumnDefinitions="*,Auto,Auto">
      <TextBox x:Name="PART_PathInput"
               Grid.Column="0"
               Classes="studio-input mono"
               Watermark="characters/..." />

      <Button x:Name="PART_DropdownButton"
              Grid.Column="1"
              Margin="4,0,0,0"
              Classes="studio-btn-compact"
              Width="28"
              Height="28"
              MinWidth="28"
              MinHeight="28"
              Padding="0"
              ToolTip.Tip="Choose image from workspace">
        <Path Data="M 1,2 L 5,6 L 9,2"
              Stroke="{DynamicResource StudioTextSecondaryBrush}"
              StrokeThickness="1.5"
              StrokeLineCap="Round"
              StrokeJoin="Round"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
      </Button>

      <Button x:Name="PART_BrowseButton"
              Grid.Column="2"
              Margin="4,0,0,0"
              Classes="studio-btn-compact"
              Width="28"
              Height="28"
              MinWidth="28"
              MinHeight="28"
              Padding="0"
              ToolTip.Tip="Browse image file on disk...">
        <Path Width="14"
              Height="12"
              Data="M 1,2.5 Q 1,1 2.5,1 L 5.2,1 L 6.6,2.6 L 11.5,2.6 Q 13,2.6 13,4.1 L 13,9.5 Q 13,11 11.5,11 L 2.5,11 Q 1,11 1,9.5 Z"
              Stroke="{DynamicResource StudioTextSecondaryBrush}"
              StrokeThickness="1.35"
              StrokeLineCap="Round"
              StrokeJoin="Round"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
      </Button>
    </Grid>

    <Popup x:Name="PART_PickerPopup"
           IsLightDismissEnabled="True"
           Placement="BottomEdgeAlignedLeft"
           VerticalOffset="4"
           MaxWidth="360">
      <Border Width="356"
              CornerRadius="8"
              Background="{DynamicResource StudioSurfaceBrush}"
              BorderBrush="{DynamicResource StudioBorderStrongBrush}"
              BorderThickness="1"
              BoxShadow="0 10 28 0 #4A000000"
              Padding="10">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="PART_FilterInput"
                     Grid.Column="0"
                     Classes="studio-input"
                     Watermark="Filter workspace images..." />
            <TextBlock x:Name="PART_CountLabel"
                       Grid.Column="1"
                       Text="0 images"
                       FontSize="10.5"
                       FontWeight="Medium"
                       Foreground="{DynamicResource StudioTextMutedBrush}"
                       VerticalAlignment="Center" />
          </Grid>

          <Border x:Name="PART_EmptyState"
                  IsVisible="False"
                  CornerRadius="6"
                  Background="{DynamicResource StudioSurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource StudioBorderBrush}"
                  BorderThickness="1"
                  Padding="12,16">
            <TextBlock x:Name="PART_EmptyLabel"
                       Text="No images found in workspace"
                       FontSize="11.5"
                       Foreground="{DynamicResource StudioTextMutedBrush}"
                       HorizontalAlignment="Center" />
          </Border>

          <ScrollViewer x:Name="PART_ScrollViewer"
                        MaxHeight="230"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PART_ImageItems">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:WorkspaceImageEntry">
                  <Button Classes="studio-image-tile"
                          Width="98"
                          Height="86"
                          Margin="0,0,6,6"
                          Click="HandleImageTileClicked"
                          ToolTip.Tip="{Binding RelativePath}">
                    <Grid RowDefinitions="54,*" RowSpacing="4">
                      <Border Grid.Row="0"
                              Width="52"
                              Height="52"
                              CornerRadius="5"
                              Background="{DynamicResource StudioCanvasBrush}"
                              BorderBrush="{DynamicResource StudioBorderBrush}"
                              BorderThickness="1"
                              ClipToBounds="True"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                        <Image Source="{Binding AbsolutePath, Converter={x:Static conv:PathToThumbnailConverter.INSTANCE}}"
                               Stretch="Uniform"
                               Margin="2"
                               RenderOptions.BitmapInterpolationMode="None" />
                      </Border>
                      <TextBlock Grid.Row="1"
                                 Text="{Binding FileName}"
                                 Classes="mono"
                                 FontSize="10"
                                 Foreground="{DynamicResource StudioTextSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 MaxWidth="88" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
