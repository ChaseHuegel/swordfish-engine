      <Color x:Key="StudioDangerColor">#F87171</Color>
      <Color x:Key="StudioDangerSurfaceColor">#33181C</Color>
      <Color x:Key="StudioDangerBorderColor">#782D36</Color>

      <Color x:Key="StudioInfoColor">#60A5FA</Color>
      <Color x:Key="StudioInfoSurfaceColor">#17273E</Color>
      <Color x:Key="StudioInfoBorderColor">#2E548A</Color>

      <Color x:Key="StudioCodeCommentColor">#7C8BA5</Color>
      <Color x:Key="StudioCodeSectionColor">#7AA8FF</Color>
      <Color x:Key="StudioCodeKeyColor">#9CD6FE</Color>
      <Color x:Key="StudioCodeStringColor">#7AE0A3</Color>
      <Color x:Key="StudioCodeNumberColor">#F6C177</Color>

      <Color x:Key="StudioModalBackdropColor">#A807090E</Color>
