      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource StudioBorderStrongColor}" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource StudioAccentSurfaceColor}" />
