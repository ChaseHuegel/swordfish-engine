<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="StudioFontSans">avares://Avalonia.Fonts.Inter/Assets#Inter, Segoe UI, Liberation Sans</FontFamily>
  <FontFamily x:Key="StudioFontMono">Cascadia Mono, Consolas, Liberation Mono, Monospace</FontFamily>

  <CornerRadius x:Key="StudioRadiusSm">4</CornerRadius>
  <CornerRadius x:Key="StudioRadiusMd">6</CornerRadius>
  <CornerRadius x:Key="StudioRadiusLg">10</CornerRadius>
  <CornerRadius x:Key="StudioRadiusPill">999</CornerRadius>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="StudioCanvasColor">#12151C</Color>
      <Color x:Key="StudioSurfaceColor">#181C25</Color>
      <Color x:Key="StudioSurfaceElevatedColor">#1F2533</Color>
      <Color x:Key="StudioSurfaceSunkenColor">#0E1117</Color>
      <Color x:Key="StudioBorderColor">#2A3244</Color>
      <Color x:Key="StudioBorderStrongColor">#3B465E</Color>

      <Color x:Key="StudioTextPrimaryColor">#EEF2F8</Color>
      <Color x:Key="StudioTextSecondaryColor">#A8B5CC</Color>
      <Color x:Key="StudioTextMutedColor">#7886A0</Color>

      <Color x:Key="StudioAccentColor">#4F8CFF</Color>
      <Color x:Key="StudioAccentHoverColor">#689DFF</Color>
      <Color x:Key="StudioAccentPressedColor">#3A76E8</Color>
      <Color x:Key="StudioAccentForegroundColor">#FFFFFF</Color>
      <Color x:Key="StudioAccentSurfaceColor">#1A2B48</Color>
      <Color x:Key="StudioAccentBorderColor">#3761AE</Color>

      <Color x:Key="StudioSuccessColor">#34D399</Color>
