      <Color x:Key="StudioInfoColor">#1E5ED6</Color>
      <Color x:Key="StudioInfoSurfaceColor">#EAF1FF</Color>
      <Color x:Key="StudioInfoBorderColor">#A1C1F8</Color>

      <Color x:Key="StudioCodeCommentColor">#69778F</Color>
      <Color x:Key="StudioCodeSectionColor">#1D4ED8</Color>
      <Color x:Key="StudioCodeKeyColor">#0D5B8A</Color>
      <Color x:Key="StudioCodeStringColor">#0E7A48</Color>
