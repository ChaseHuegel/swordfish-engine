      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource StudioAccentSurfaceColor}" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource StudioAccentSurfaceColor}" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource StudioTextPrimaryColor}" />
