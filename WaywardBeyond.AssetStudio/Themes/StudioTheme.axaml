      <SolidColorBrush x:Key="StudioDangerBrush" Color="{StaticResource StudioDangerColor}" />
      <SolidColorBrush x:Key="StudioDangerSurfaceBrush" Color="{StaticResource StudioDangerSurfaceColor}" />
      <SolidColorBrush x:Key="StudioDangerBorderBrush" Color="{StaticResource StudioDangerBorderColor}" />

      <SolidColorBrush x:Key="StudioInfoBrush" Color="{StaticResource StudioInfoColor}" />
