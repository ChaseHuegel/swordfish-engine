<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WaywardBeyond.AssetStudio.ViewModels"
             xmlns:controls="clr-namespace:WaywardBeyond.AssetStudio.Controls"
             x:Class="WaywardBeyond.AssetStudio.Views.Forms.BrickFormView"
             x:DataType="vm:AssetDocumentViewModel">
  <StackPanel>
    <!-- Shape & Appearance -->
    <controls:CollapsibleSectionCard Title="Shape &amp; Appearance">
      <StackPanel Spacing="4">
        <controls:ScalarFieldRowControl DataContext="{Binding BrickShapeField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickColorField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickAlphaField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickCastShadowsField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickPassableField}" />
      </StackPanel>
    </controls:CollapsibleSectionCard>

    <!-- Statistics (extensible key-value numeric attributes such as wb:hardness) -->
    <controls:CollapsibleSectionCard Title="Statistics"
                                     Subtitle="Custom numeric attributes (e.g. wb:hardness)"
                                     IsExpanded="{Binding HasStatistics}">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
          <TextBlock Grid.Column="0"
                     Text="Define any built-in or mod statistic key in [Bricks.Statistics]."
                     FontSize="11"
                     Foreground="{DynamicResource StudioTextMutedBrush}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Classes="studio-btn-compact"
                  Command="{Binding AddHardnessStatisticCommand}"
                  IsEnabled="{Binding !IsReadOnly}"
                  Content="+ Hardness" />
          <Button Grid.Column="2"
                  Classes="studio-btn-compact"
                  Command="{Binding AddPowerKwStatisticCommand}"
                  IsEnabled="{Binding !IsReadOnly}"
                  Content="+ Power (kW)" />
          <Button Grid.Column="3"
                  Classes="studio-btn-compact"
                  Command="{Binding AddStatisticCommand}"
                  IsEnabled="{Binding !IsReadOnly}"
                  Content="+ Add Statistic" />
        </Grid>

        <Border CornerRadius="6"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                IsVisible="{Binding HasStatistics}">
          <StackPanel>
            <Border Background="{DynamicResource StudioSurfaceElevatedBrush}" Padding="8,6">
              <Grid ColumnDefinitions="*,110,28" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="STATISTIC KEY" Classes="pane-title" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="VALUE" Classes="pane-title" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Statistics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatisticRowViewModel">
                  <Border BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,110,28" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Key, Mode=TwoWay}"
                                 IsUndoEnabled="False"
                                 Classes="studio-input mono"
                                 Classes.danger="{Binding HasKeyError}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Value, Mode=TwoWay}"
                                 IsUndoEnabled="False"
                                 Classes="studio-input mono"
                                 Classes.danger="{Binding IsInvalidValue}" />
                        <Button Grid.Column="2"
                                Classes="studio-btn-ghost"
                                Width="26"
                                Height="26"
                                MinHeight="26"
                                Padding="0"
                                Command="{Binding $parent[UserControl].((vm:AssetDocumentViewModel)DataContext).RemoveStatisticCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Remove statistic">
                          <TextBlock Text="×" FontSize="14" />
                        </Button>
                      </Grid>
                      <TextBlock Text="{Binding ValidationError}"
                                 IsVisible="{Binding HasValidationError}"
                                 FontSize="10.5"
                                 Foreground="{DynamicResource StudioDangerBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </controls:CollapsibleSectionCard>

    <!-- Entity Light -->
    <controls:CollapsibleSectionCard Title="Entity Light"
                                     Subtitle="Optional point-light config ([Bricks.Entity.Light])"
                                     IsExpanded="{Binding BrickHasEntityLight}">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <TextBlock Grid.Column="0"
                     Text="Attaches a data-driven LightComponent via LightEntityDecorator."
                     FontSize="11"
                     Foreground="{DynamicResource StudioTextMutedBrush}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Classes="studio-btn-compact"
                  Command="{Binding EnableBrickEntityLightCommand}"
                  IsVisible="{Binding !BrickHasEntityLight}"
                  IsEnabled="{Binding !IsReadOnly}"
                  Content="+ Add Entity Light" />
          <Button Grid.Column="2"
                  Classes="studio-btn-compact"
                  Command="{Binding RemoveBrickEntityLightCommand}"
                  IsVisible="{Binding BrickHasEntityLight}"
                  IsEnabled="{Binding !IsReadOnly}"
                  Content="Remove Light" />
        </Grid>

        <StackPanel Spacing="4" IsVisible="{Binding BrickHasEntityLight}">
          <controls:ScalarFieldRowControl DataContext="{Binding BrickEntityLightColorField}" />
          <controls:ScalarFieldRowControl DataContext="{Binding BrickEntityLightIntensityField}" />
          <controls:ScalarFieldRowControl DataContext="{Binding BrickEntityLightRadiusField}" />
          <controls:ScalarFieldRowControl DataContext="{Binding BrickEntityLightSizeField}" />
          <controls:ScalarFieldRowControl DataContext="{Binding BrickEntityLightCastShadowsField}" />
          <controls:ScalarFieldRowControl DataContext="{Binding BrickEntityLightOffsetField}" />
          <controls:ScalarFieldRowControl DataContext="{Binding BrickEntityLightTintFromPaintField}" />
        </StackPanel>
      </StackPanel>
    </controls:CollapsibleSectionCard>

    <!-- Entity Slot Groups -->
    <controls:CollapsibleSectionCard Title="Entity Slot Groups"
                                     Subtitle="Inventory slot groups ([[Bricks.Entity.SlotGroups]])"
                                     IsExpanded="{Binding HasBrickEntitySlotGroups}">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBlock Grid.Column="0"
                     Text="Provision keyed inventory slot groups on placed brick entities."
                     FontSize="11"
                     Foreground="{DynamicResource StudioTextMutedBrush}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Classes="studio-btn-compact"
                  Command="{Binding AddBrickEntitySlotGroupCommand}"
                  IsEnabled="{Binding !IsReadOnly}"
                  Content="+ Add Slot Group" />
        </Grid>

        <Border CornerRadius="6"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                IsVisible="{Binding HasBrickEntitySlotGroups}">
          <StackPanel>
            <Border Background="{DynamicResource StudioSurfaceElevatedBrush}" Padding="8,6">
              <Grid ColumnDefinitions="*,110,28" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="SLOT GROUP ID" Classes="pane-title" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="CAPACITY" Classes="pane-title" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding BrickEntitySlotGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BrickSlotGroupRowViewModel">
                  <Border BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
                    <Grid ColumnDefinitions="*,110,28" ColumnSpacing="8">
                      <TextBox Grid.Column="0"
                               Text="{Binding GroupId, Mode=TwoWay}"
                               IsReadOnly="{Binding IsReadOnly}"
                               IsUndoEnabled="False"
                               Watermark="wb:cargo"
                               Classes="studio-input mono" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Capacity, Mode=TwoWay}"
                               IsReadOnly="{Binding IsReadOnly}"
                               IsUndoEnabled="False"
                               Watermark="schema default"
                               Classes="studio-input mono" />
                      <Button Grid.Column="2"
                              Classes="studio-btn-ghost"
                              Width="26"
                              Height="26"
                              MinHeight="26"
                              Padding="0"
                              Command="{Binding $parent[UserControl].((vm:AssetDocumentViewModel)DataContext).RemoveBrickEntitySlotGroupCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Remove slot group">
                        <TextBlock Text="×" FontSize="14" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </controls:CollapsibleSectionCard>

    <!-- Mesh & Per-Face Textures -->
    <controls:CollapsibleSectionCard Title="Mesh &amp; Per-Face Textures">
      <StackPanel Spacing="4">
        <controls:ScalarFieldRowControl DataContext="{Binding BrickTexDefaultField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickMeshField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickConnectedField}" />
        <Border Height="1" Background="{DynamicResource StudioBorderBrush}" Margin="0,6" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickTexTopField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickTexBottomField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickTexFrontField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickTexBackField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickTexLeftField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickTexRightField}" />
      </StackPanel>
    </controls:CollapsibleSectionCard>

    <!-- Sounds -->
    <controls:CollapsibleSectionCard Title="Sounds">
      <StackPanel Spacing="4">
        <controls:ScalarFieldRowControl DataContext="{Binding BrickSoundPlaceField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding BrickSoundBreakField}" />
      </StackPanel>
    </controls:CollapsibleSectionCard>

    <!-- Colliders -->
    <controls:CollapsibleSectionCard Title="Colliders">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="Explicit [[Bricks.Colliders]] override built-in shape colliders."
                     FontSize="11.5"
                     Foreground="{DynamicResource StudioTextMutedBrush}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Classes="studio-btn-compact"
                  Command="{Binding AddColliderCommand}"
                  IsEnabled="{Binding !IsReadOnly}"
                  Content="+ Add Collider" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Colliders}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ColliderEntryViewModel">
              <Border CornerRadius="6"
                      Background="{DynamicResource StudioSurfaceSunkenBrush}"
                      BorderBrush="{DynamicResource StudioBorderBrush}"
                      BorderThickness="1"
                      Padding="10,8"
                      Margin="0,0,0,6">
                <Grid ColumnDefinitions="96,*,*,Auto" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Type" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" />
                    <ComboBox ItemsSource="{x:Static vm:ColliderEntryViewModel.COLLIDER_TYPES}"
                              SelectedItem="{Binding ColliderType, Mode=TwoWay}"
                              Classes="studio-combo" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="Size (X, Y, Z)" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" />
                    <TextBox Text="{Binding Size, Mode=TwoWay}" Classes="studio-input mono" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="Offset (X, Y, Z)" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" />
                    <TextBox Text="{Binding Offset, Mode=TwoWay}" Classes="studio-input mono" />
                  </StackPanel>
                  <Button Grid.Column="3"
                          VerticalAlignment="Bottom"
                          Classes="studio-btn-ghost"
                          Width="28"
                          Command="{Binding $parent[UserControl].((vm:AssetDocumentViewModel)DataContext).RemoveColliderCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Remove collider">
                    <TextBlock Text="×" FontSize="14" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </controls:CollapsibleSectionCard>
  </StackPanel>
</UserControl>
