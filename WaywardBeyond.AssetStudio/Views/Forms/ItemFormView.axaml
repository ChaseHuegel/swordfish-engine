<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WaywardBeyond.AssetStudio.ViewModels"
             xmlns:controls="clr-namespace:WaywardBeyond.AssetStudio.Controls"
             x:Class="WaywardBeyond.AssetStudio.Views.Forms.ItemFormView"
             x:DataType="vm:AssetDocumentViewModel">
  <StackPanel>
    <!-- Placeable -->
    <controls:CollapsibleSectionCard Title="Placeable">
      <StackPanel Spacing="4">
        <controls:ScalarFieldRowControl DataContext="{Binding ItemPlaceableTypeField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding ItemPlaceableIdField}" />
      </StackPanel>
    </controls:CollapsibleSectionCard>

    <!-- Tool (collapsed by default on placeable items) -->
    <controls:CollapsibleSectionCard Title="Tool" IsExpanded="False">
      <StackPanel Spacing="4">
        <controls:ScalarFieldRowControl DataContext="{Binding ItemToolTypeField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding ItemToolTargetField}" />
      </StackPanel>
    </controls:CollapsibleSectionCard>

    <!-- Consumable ([Items.Consumable] & [[Items.Consumable.Modifiers]]) -->
    <controls:CollapsibleSectionCard Title="Consumable"
                                     Subtitle="{Binding ItemConsumableSummary}"
                                     IsExpanded="{Binding HasConsumable}">
      <controls:CollapsibleSectionCard.HeaderAction>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="studio-btn-compact"
                  IsVisible="{Binding !HasConsumable}"
                  IsEnabled="{Binding !IsReadOnly}"
                  Command="{Binding EnableItemConsumableCommand}"
                  Content="+ Enable Consumable" />
          <Button Classes="studio-btn-compact"
                  IsVisible="{Binding HasConsumable}"
                  IsEnabled="{Binding !IsReadOnly}"
                  Command="{Binding RemoveItemConsumableCommand}"
                  ToolTip.Tip="Remove [Items.Consumable] and all consumable modifiers from this item"
                  Content="Remove Consumable" />
        </StackPanel>
      </controls:CollapsibleSectionCard.HeaderAction>
      <StackPanel Spacing="6">
        <TextBlock IsVisible="{Binding !HasConsumable}"
                   Text="This item is not consumable. Click '+ Enable Consumable' to configure cooldown, buff, and statistic modifiers."
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />

        <StackPanel IsVisible="{Binding HasConsumable}" Spacing="6">
          <StackPanel Spacing="2">
            <controls:ScalarFieldRowControl DataContext="{Binding ItemConsumableBuffIdField}" />
            <controls:ScalarFieldRowControl DataContext="{Binding ItemConsumableCooldownField}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0"
                       Text="One-shot statistic modifiers applied in declaration order on use ([[Items.Consumable.Modifiers]])."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource StudioTextMutedBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="studio-btn-compact"
                    Command="{Binding AddItemConsumableModifierCommand}"
                    IsEnabled="{Binding !IsReadOnly}"
                    Content="+ Add Modifier" />
          </Grid>

          <Border CornerRadius="6"
                  BorderBrush="{DynamicResource StudioBorderBrush}"
                  BorderThickness="1"
                  ClipToBounds="True">
            <StackPanel>
              <Border Background="{DynamicResource StudioSurfaceElevatedBrush}" Padding="8,6">
                <Grid ColumnDefinitions="*,100,100,28" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="STAT ID" Classes="pane-title" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="FLAT DELTA" Classes="pane-title" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="PERCENT DELTA" Classes="pane-title" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <TextBlock IsVisible="{Binding ItemConsumableHasNoModifiers}"
                         Text="No consumable modifiers configured."
                         FontSize="11.5"
                         Foreground="{DynamicResource StudioTextMutedBrush}"
                         Margin="10,10" />

              <ItemsControl ItemsSource="{Binding ItemConsumableModifiers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConsumableStatModifierRowViewModel">
                    <Border BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
                      <Grid ColumnDefinitions="*,100,100,28" ColumnSpacing="6">
                        <TextBox Grid.Column="0"
                                 Text="{Binding StatId, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 IsUndoEnabled="False"
                                 Watermark="wb:health"
                                 Classes="studio-input mono" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding FlatDelta, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 IsUndoEnabled="False"
                                 Watermark="optional"
                                 Classes="studio-input mono" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding PercentDelta, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 IsUndoEnabled="False"
                                 Watermark="0.25"
                                 Classes="studio-input mono" />
                        <Button Grid.Column="3"
                                Classes="studio-btn-ghost"
                                Width="26"
                                Height="26"
                                MinHeight="26"
                                Padding="0"
                                IsEnabled="{Binding $parent[UserControl].((vm:AssetDocumentViewModel)DataContext).CanEditDocument}"
                                Command="{Binding $parent[UserControl].((vm:AssetDocumentViewModel)DataContext).RemoveItemConsumableModifierCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Remove consumable modifier">
                          <TextBlock Text="×" FontSize="14" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </controls:CollapsibleSectionCard>

    <!-- Statistics (extensible key-value numeric attributes such as wb:mining_speed) -->
    <controls:CollapsibleSectionCard Title="Statistics"
                                     Subtitle="Custom numeric attributes (e.g. wb:mining_speed)"
                                     IsExpanded="{Binding HasStatistics}">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <TextBlock Grid.Column="0"
                     Text="Define any built-in or mod statistic key in [Items.Statistics]."
                     FontSize="11"
                     Foreground="{DynamicResource StudioTextMutedBrush}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Classes="studio-btn-compact"
                  Command="{Binding AddMiningSpeedStatisticCommand}"
                  IsEnabled="{Binding !IsReadOnly}"
                  Content="+ Mining Speed" />
          <Button Grid.Column="2"
                  Classes="studio-btn-compact"
                  Command="{Binding AddStatisticCommand}"
                  IsEnabled="{Binding !IsReadOnly}"
                  Content="+ Add Statistic" />
        </Grid>

        <Border CornerRadius="6"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                IsVisible="{Binding HasStatistics}">
          <StackPanel>
            <Border Background="{DynamicResource StudioSurfaceElevatedBrush}" Padding="8,6">
              <Grid ColumnDefinitions="*,110,28" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="STATISTIC KEY" Classes="pane-title" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="VALUE" Classes="pane-title" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Statistics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatisticRowViewModel">
                  <Border BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,110,28" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Key, Mode=TwoWay}"
                                 IsUndoEnabled="False"
                                 Classes="studio-input mono"
                                 Classes.danger="{Binding HasKeyError}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Value, Mode=TwoWay}"
                                 IsUndoEnabled="False"
                                 Classes="studio-input mono"
                                 Classes.danger="{Binding IsInvalidValue}" />
                        <Button Grid.Column="2"
                                Classes="studio-btn-ghost"
                                Width="26"
                                Height="26"
                                MinHeight="26"
                                Padding="0"
                                Command="{Binding $parent[UserControl].((vm:AssetDocumentViewModel)DataContext).RemoveStatisticCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Remove statistic">
                          <TextBlock Text="×" FontSize="14" />
                        </Button>
                      </Grid>
                      <TextBlock Text="{Binding ValidationError}"
                                 IsVisible="{Binding HasValidationError}"
                                 FontSize="10.5"
                                 Foreground="{DynamicResource StudioDangerBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </controls:CollapsibleSectionCard>

    <!-- ViewModel -->
    <controls:CollapsibleSectionCard Title="View Model" IsExpanded="False">
      <controls:CollapsibleSectionCard.HeaderAction>
        <Button Classes="studio-btn-compact active"
                Padding="9,0"
                IsEnabled="{Binding CanShowForm}"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenViewModelEditorCommand}"
                ToolTip.Tip="Open full first-person 3D View Model editor">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <Path Width="12"
                  Height="12"
                  Stretch="Uniform"
                  Data="M 6,1 L 11,3.8 L 11,8.8 L 6,11.5 L 1,8.8 L 1,3.8 Z M 1,3.8 L 6,6.5 L 11,3.8 M 6,6.5 L 6,11.5"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.3"
                  StrokeLineCap="Round"
                  StrokeJoin="Round" />
            <TextBlock Text="Edit Visually" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </controls:CollapsibleSectionCard.HeaderAction>
      <StackPanel Spacing="4">
        <controls:ScalarFieldRowControl DataContext="{Binding ItemViewModelMeshField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding ItemViewModelMaterialField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding ItemViewModelPositionField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding ItemViewModelRotationField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding ItemViewModelScaleField}" />
      </StackPanel>
    </controls:CollapsibleSectionCard>

    <!-- WorldModel (badged Informational · unread) -->
    <controls:CollapsibleSectionCard Title="World Model"
                                     BadgeText="Informational · unread">
      <controls:CollapsibleSectionCard.HeaderAction>
        <Button Classes="studio-btn-compact active"
                Padding="9,0"
                IsEnabled="{Binding CanShowForm}"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenWorldModelEditorCommand}"
                ToolTip.Tip="Open full 3D World Model editor with 1 m floor &amp; 1.8 m body reference">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <Path Width="12"
                  Height="12"
                  Stretch="Uniform"
                  Data="M 6,1 L 11,3.8 L 11,8.8 L 6,11.5 L 1,8.8 L 1,3.8 Z M 1,3.8 L 6,6.5 L 11,3.8 M 6,6.5 L 6,11.5"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.3"
                  StrokeLineCap="Round"
                  StrokeJoin="Round" />
            <TextBlock Text="Edit Visually" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </controls:CollapsibleSectionCard.HeaderAction>
      <StackPanel Spacing="4">
        <controls:ScalarFieldRowControl DataContext="{Binding ItemWorldModelMeshField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding ItemWorldModelMaterialField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding ItemWorldModelPositionField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding ItemWorldModelRotationField}" />
        <controls:ScalarFieldRowControl DataContext="{Binding ItemWorldModelScaleField}" />
      </StackPanel>
    </controls:CollapsibleSectionCard>

    <!-- Stack -->
    <controls:CollapsibleSectionCard Title="Stack">
      <StackPanel Spacing="4">
        <controls:ScalarFieldRowControl DataContext="{Binding ItemMaxStackField}" />
      </StackPanel>
    </controls:CollapsibleSectionCard>
  </StackPanel>
</UserControl>
