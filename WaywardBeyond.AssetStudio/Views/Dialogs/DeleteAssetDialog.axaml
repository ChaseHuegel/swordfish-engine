<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WaywardBeyond.AssetStudio.ViewModels"
             xmlns:models="clr-namespace:WaywardBeyond.AssetStudio.Models"
             x:Class="WaywardBeyond.AssetStudio.Views.Dialogs.DeleteAssetDialog"
             x:DataType="vm:DeleteAssetDialogViewModel">
  <Border Classes="studio-dialog" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="True">
    <StackPanel>
      <!-- Header -->
      <Border Background="{DynamicResource StudioSurfaceElevatedBrush}"
              BorderBrush="{DynamicResource StudioBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="20,14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="Delete Asset" FontSize="15" FontWeight="Bold" />
            <TextBlock Text="Confirm permanent removal from the active workspace."
                       FontSize="11.5"
                       Foreground="{DynamicResource StudioTextSecondaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Top" Classes="studio-btn-ghost" Command="{Binding CancelCommand}" Content="×" FontSize="16" />
        </Grid>
      </Border>

      <!-- Body -->
      <StackPanel Margin="20,16" Spacing="12">
        <Border CornerRadius="6"
                Background="{DynamicResource StudioSurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1"
                Padding="12,10">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding AssetId}"
                         Classes="mono"
                         FontSize="13"
                         FontWeight="Bold"
                         Foreground="{DynamicResource StudioTextPrimaryBrush}" />
              <Border Classes="studio-badge info">
                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding RelativeFile}"
                       Classes="mono"
                       FontSize="11"
                       Foreground="{DynamicResource StudioTextMutedBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ActionSummary}"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource StudioTextSecondaryBrush}" />
          </StackPanel>
        </Border>

        <!-- Inbound References Warning -->
        <Border IsVisible="{Binding HasInboundReferences}" Classes="studio-banner-warning">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding InboundWarningTitle}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StudioWarningBrush}" />
            <TextBlock Text="Deleting this asset may leave broken references in the files below."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource StudioTextSecondaryBrush}" />
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding InboundReferences}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:InboundReferenceItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding SourceAssetId}"
                                 Classes="mono"
                                 FontSize="11"
                                 Foreground="{DynamicResource StudioTextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding SourceFile}"
                                 Classes="mono"
                                 FontSize="10"
                                 Foreground="{DynamicResource StudioTextMutedBrush}"
                                 Margin="8,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Footer -->
      <Border Background="{DynamicResource StudioSurfaceElevatedBrush}"
              BorderBrush="{DynamicResource StudioBorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="20,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Classes="studio-btn" Command="{Binding CancelCommand}" Content="Cancel" />
          <Button Classes="studio-btn-danger" Command="{Binding ConfirmDeleteCommand}" Content="Delete Asset" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
