<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WaywardBeyond.AssetStudio.ViewModels"
             x:Class="WaywardBeyond.AssetStudio.Views.Dialogs.AboutDialog"
             x:DataType="vm:AboutDialogViewModel">
  <Border Classes="studio-dialog" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="True">
    <StackPanel>
      <Border Background="{DynamicResource StudioSurfaceElevatedBrush}"
              BorderBrush="{DynamicResource StudioBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="20,14">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource StudioAccentBrush}">
              <TextBlock Text="WB" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StudioAccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
              <TextBlock Text="Wayward Beyond Asset Studio" FontSize="15" FontWeight="Bold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Info.ToolVersion, StringFormat='Version {0}'}" Classes="mono" FontSize="11" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                <Border Classes="studio-badge info">
                  <TextBlock Text="{Binding ContentVersionLabel}" Classes="mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource StudioInfoBrush}" />
                </Border>
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" Classes="studio-btn-ghost" Command="{Binding CloseCommand}" Content="×" FontSize="16" />
        </Grid>
      </Border>

      <StackPanel Margin="20,16" Spacing="12">
        <Border CornerRadius="6"
                Background="{DynamicResource StudioSurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1"
                Padding="14,12">
          <Grid ColumnDefinitions="136,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="9">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Workspace Mode" FontSize="11.5" Foreground="{DynamicResource StudioTextMutedBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Info.WorkspaceModeLabel}" FontSize="12" FontWeight="SemiBold" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Workspace Roots" FontSize="11.5" Foreground="{DynamicResource StudioTextMutedBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Info.RootsSummary}" Classes="mono" FontSize="11" TextWrapping="Wrap" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="OS &amp; Arch" FontSize="11.5" Foreground="{DynamicResource StudioTextMutedBrush}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Info.OsArchitecture}" Classes="mono" FontSize="11" TextWrapping="Wrap" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="GL Renderer" FontSize="11.5" Foreground="{DynamicResource StudioTextMutedBrush}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Info.GlVendorRenderer}" Classes="mono" FontSize="11" TextWrapping="Wrap" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Avalonia UI" FontSize="11.5" Foreground="{DynamicResource StudioTextMutedBrush}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Info.AvaloniaVersion}" Classes="mono" FontSize="11" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Diagnostic Log" FontSize="11.5" Foreground="{DynamicResource StudioTextMutedBrush}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Info.LogPath}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border IsVisible="{Binding HasCopyStatus}" Classes="studio-banner-info">
          <TextBlock Text="{Binding CopyStatusMessage}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource StudioInfoBrush}" />
        </Border>
      </StackPanel>

      <Border Background="{DynamicResource StudioSurfaceElevatedBrush}"
              BorderBrush="{DynamicResource StudioBorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="20,12">
        <Grid ColumnDefinitions="*,Auto">
          <Button Grid.Column="0"
                  HorizontalAlignment="Left"
                  Classes="studio-btn-primary"
                  Command="{Binding CopyDiagnosticsZipCommand}"
                  Content="Copy Diagnostics Zip" />
          <Button Grid.Column="1" Classes="studio-btn" Command="{Binding CloseCommand}" Content="Close" />
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
