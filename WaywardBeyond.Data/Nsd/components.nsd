#version 1.0;
#namespace WaywardBeyond.Data.Components;
#include "saves.nsd";

message InputComponent
{
    float MovementX           = 0;
    float MovementY           = 1;
    float MovementZ           = 2;
    float LookPitch           = 3;
    float LookYaw             = 4;
    float LookRoll            = 5;
    uint  SequenceNumber      = 6;
    uint  ServerTickAtSample  = 7;
    bool  PrimaryHeld         = 9;
    bool  SecondaryHeld       = 10;
    string? PaintId           = 11;
}

message BodyViewComponent
{
    string Body = 0;
}

message LaserBeamComponent
{
    float TargetX = 0;
    float TargetY = 1;
    float TargetZ = 2;
    float NormalX = 3;
    float NormalY = 4;
    float NormalZ = 5;
    bool  Hit     = 6;
}

message ParticleEmitterMessage
{
    string EffectId        = 0;
    bool   Playing         = 1;
    float  RateScale       = 2;
    float  OffsetX         = 3;
    float  OffsetY         = 4;
    float  OffsetZ         = 5;
    float  LocalDirectionX = 6;
    float  LocalDirectionY = 7;
    float  LocalDirectionZ = 8;
    uint   TintRgba        = 9;
}

message ParticleEmitterBindingComponent
{
    ulong ParentEntity = 0;
}

message ColliderMessage
{
    ColliderShapeMessage[] Shapes       = 0;
    Float3Message[]        Positions    = 1;
    Float4Message[]        Orientations = 2;
}

message ColliderShapeMessage
{
    byte           Type   = 0;
    float          X      = 1;
    float          Y      = 2;
    float          Z      = 3;
    float          W      = 4;
    Float3Message[] Points = 5;
}

message Float3Message
{
    float X = 0;
    float Y = 1;
    float Z = 2;
}

message Float4Message
{
    float X = 0;
    float Y = 1;
    float Z = 2;
    float W = 3;
}

message IdentifierMessage
{
    string Name = 0;
    string Tag  = 1;
}

message EquipmentComponent
{
    int ActiveInventorySlot = 0;
}

message InventoryComponent
{
    WaywardBeyond.Data.ItemData[] Contents = 0;
}

message GameModeComponent
{
    int Value = 0;
}

message InteractionEvent
{
    ulong Entity = 0;
    uint SequenceNumber = 1;
    uint ServerTickAtSample = 2;
    InteractionKind Kind = 3;
    BrickInteraction? Brick = 4;
    PaintInteraction? Paint = 5;
}

enum InteractionKind
{
    None = 0;
    PrimaryPressed = 1;
    PrimaryReleased = 2;
    SecondaryPressed = 3;
    SecondaryReleased = 4;
}

message BrickInteraction
{
    ulong TargetEntity = 0;
    int  TargetX = 1;
    int  TargetY = 2;
    int  TargetZ = 3;
    byte HintShape = 4;
    byte HintOrientation = 5;
}

message PaintInteraction
{
    ulong TargetEntity = 0;
    int TargetX = 1;
    int TargetY = 2;
    int TargetZ = 3;
    byte FaceMask = 4;
    byte Mode = 5;
    string? PaintId = 6;
}

message InventoryEvent
{
    ulong Entity              = 0;
    uint  SequenceNumber      = 1;
    SlotMoveOp? SlotMove      = 2;
}

message SlotMoveOp
{
    SlotMoveOpMode Mode = 0;
    int FromSlot = 1;
    int ToSlot = 2;
    uint? Count = 3;
}

enum SlotMoveOpMode
{
    Exact = 0;
    AutoStack = 1;
}