#version 1.0;
#namespace WaywardBeyond.Data.Networking;
#include "voxels.nsd";

message ComponentSnapshot
{
    ulong Entity    = 0;
    ulong TypeUuid  = 1;
    byte[] Payload  = 2;
}

message ComponentRemoval
{
    ulong Entity   = 0;
    ulong TypeUuid = 1;
}

message WorldSnapshot
{
    uint TickNumber           = 0;
    uint LastProcessedInput   = 1;
    ComponentSnapshot[] Components     = 2;
    ulong[] RemovedEntities   = 3;
    ComponentRemoval[] RemovedComponents = 4;
}

message SnapshotBatch
{
    uint BatchId = 0;
    uint PartIndex = 1;
    uint PartCount = 2;
    byte[] Payload = 3;
}

message LevelStreamChunk
{
    uint PartIndex = 0;
    uint PartCount = 1;
    byte[] Payload = 2;
}

message StreamLevelRequest
{
    string LevelGuid = 0;
}

message TransformMessage
{
    float PositionX      = 0;
    float PositionY      = 1;
    float PositionZ      = 2;
    float OrientationX   = 3;
    float OrientationY   = 4;
    float OrientationZ   = 5;
    float OrientationW   = 6;
    float ScaleX         = 7;
    float ScaleY         = 8;
    float ScaleZ         = 9;
}

message PhysicsMessage
{
    float VelocityX          = 0;
    float VelocityY          = 1;
    float VelocityZ          = 2;
    float AngularVelocityX   = 3;
    float AngularVelocityY   = 4;
    float AngularVelocityZ   = 5;
    byte  Layer              = 6;
    byte  BodyType           = 7;
    byte  CollisionDetection = 8;
}

message VoxelEditMessage
{
    ulong EntityUuid = 0;
    int X = 1;
    int Y = 2;
    int Z = 3;
    WaywardBeyond.Data.Voxel Voxel = 4;
    uint Sequence = 5;
    string? BrickId = 6;
}

message VoxelFaceEditMessage
{
    ulong EntityUuid = 0;
    int X = 1;
    int Y = 2;
    int Z = 3;
    byte FaceMask = 4;
    byte Mode = 5;
    string? PaintId = 6;
    uint Sequence = 7;
}

enum NotificationType
{
    Toast = 0;
    Action = 1;
    Interaction = 2;
    Bar = 3;
}

message NotificationMessage
{
    NotificationType Type = 0;
    string Key = 1;
    string[] Args = 2;
    string? ID = 3;
    float? Amount = 4;
    string? Subtext = 5;
    string[]? SubtextArgs = 6;
    int? Segments = 7;
    uint? Color = 8;
}

message SkillStateUpdateMessage
{
    string SkillId = 0;
    long TotalXP = 1;
    int Level = 2;
    long XPIntoLevel = 3;
    long GainedXP = 4;
}

message ChatMessage
{
    ulong CharacterUuid = 0;
    string SenderName = 1;
    string Value = 2;
}

message ServerHeartbeatMessage
{
    uint TPS = 0;
    uint TickNumber = 1;
    uint PlayerCount = 2;
}

message ClientHeartbeatMessage
{
    uint TickNumber = 0;
    uint LastAppliedSnapshotTick = 1;
}

message ParticleBurstEntry
{
    string EffectId   = 0;
    float  PositionX  = 1;
    float  PositionY  = 2;
    float  PositionZ  = 3;
    float  DirectionX = 4;
    float  DirectionY = 5;
    float  DirectionZ = 6;
    int?   Count      = 7;
    float  SpeedScale = 8;
    float  SizeScale  = 9;
    uint   TintRgba   = 10;
}

message ParticleBurstBatchMessage
{
    ParticleBurstEntry[] Bursts = 0;
}

message ServerDiscoveryRequest
{
    byte Dummy = 0;
}

message ServerDiscovery
{
    string ServerName      = 0;
    int    TcpPort         = 1;
    int    ProtocolVersion = 2;
    int    PlayerCount     = 3;
}

enum PasteTargetKind
{
    IntoStructure = 0;
    NewStructure = 1;
}

message CutRegionRequest
{
    ulong TargetEntity = 0;
    int MinX = 1;
    int MinY = 2;
    int MinZ = 3;
    int MaxX = 4;
    int MaxY = 5;
    int MaxZ = 6;
}

message PasteRegionRequest
{
    PasteTargetKind TargetKind = 0;
    ulong TargetEntity = 1;
    int OriginX = 2;
    int OriginY = 3;
    int OriginZ = 4;
    float SpawnX = 5;
    float SpawnY = 6;
    float SpawnZ = 7;
    float SpawnOrientationX = 8;
    float SpawnOrientationY = 9;
    float SpawnOrientationZ = 10;
    float SpawnOrientationW = 11;
    bool OverwriteAir = 12;
    int SizeX = 13;
    int SizeY = 14;
    int SizeZ = 15;
    ChunkInfo[] Chunks = 16;
    string[]? BrickPalette = 17;
    string[]? PaintPalette = 18;
}

message RegionUploadPart
{
    uint BatchId = 0;
    uint PartIndex = 1;
    uint PartCount = 2;
    byte[] Payload = 3;
}

message RegionOpResponse
{
    bool Success = 0;
    bool Completed = 1;
    string? ErrorKey = 2;
    ulong SpawnedEntityUuid = 3;
    int AffectedBricks = 4;
    int SkippedUnknownBricks = 5;
}

message VoxelRegionEditMessage
{
    ulong EntityUuid = 0;
    int OriginX = 1;
    int OriginY = 2;
    int OriginZ = 3;
    bool OverwriteAir = 4;
    int SizeX = 5;
    int SizeY = 6;
    int SizeZ = 7;
    ChunkInfo[] Chunks = 8;
    string[]? BrickPalette = 9;
    string[]? PaintPalette = 10;
}

message VoxelRegionEditPart
{
    uint BatchId = 0;
    uint PartIndex = 1;
    uint PartCount = 2;
    byte[] Payload = 3;
}

message VoxelEntitySpawnPart
{
    uint BatchId = 0;
    uint PartIndex = 1;
    uint PartCount = 2;
    byte[] Payload = 3;
}