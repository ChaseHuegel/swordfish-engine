#version 1.0;
#namespace WaywardBeyond.Data;

enum GameMode
{
    Creative;
    Adventure;
}

message Version
{
    uint DataVersion   = 0;
    string Name        = 1;
    string Environment = 2;
}

message Playtime
{
    long LastPlayedMs = 0;
    long AgeMs        = 1;
}

message LevelMetadata
{
    Playtime Playtime = 0;
}

message Level
{
    Version Version = 0;
    
    long Seed = 1;
    
    Playtime Playtime = 2;
    
    int SpawnX = 4;
    int SpawnY = 5;
    int SpawnZ = 6;

    GameMode DefaultGameMode = 7;
    
    string Guid = 8;
    string Name = 9;
}

message Character
{
    Version Version = 0;
    
    ulong Uuid = 1;
    
    Playtime Playtime = 2;
    
    string Name = 4;
    
    string Body = 11;
    
    int ActiveInventorySlot = 12;
    GameMode GameMode = 13;
    
    Statistic[]? Statistics = 15;
    
    KeyedSlotEntry[]? Inventory = 20;
}

message KeyedSlotEntry
{
    string GroupId = 0;
    int LocalIndex = 1;
    ItemData Item = 2;
}

message ItemData
{
    string ID = 0;
    int Count = 1;
    int MaxSize = 2;
}

message Statistic
{
    string ID = 0;
    long Value = 1;
}

message CharacterEntityData
{
    ulong Uuid = 0;
    
    double X = 1;
    double Y = 2;
    double Z = 3;
    
    float OrientationX = 4;
    float OrientationY = 5;
    float OrientationZ = 6;
    float OrientationW = 7;
    
    float ScaleX = 8;
    float ScaleY = 9;
    float ScaleZ = 10;
    
    GameMode GameMode = 11;
    
    Statistic[]? Statistics = 12;
}

message BlockEntityData
{
    ulong VoxelEntityUuid  = 0;
    int   VoxelX           = 1;
    int   VoxelY           = 2;
    int   VoxelZ           = 3;
    string BrickId         = 4;
    string StationTag      = 5;
    string? ActiveRecipeId = 6;
    float Progress         = 7;
    float Duration         = 8;
    bool  PowerEnabled     = 9;
    byte  StatusFlags      = 10;
    KeyedSlotEntry[]? Inventory = 11;
}
