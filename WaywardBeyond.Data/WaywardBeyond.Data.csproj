<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <Version>0.1.0-alpha</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CsvHelper" Version="33.1.0" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.6" />
        <PackageReference Include="Needlefish.Generators" Version="1.2.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Swordfish.ECS\Swordfish.ECS.csproj" />
      <ProjectReference Include="..\Swordfish.Library\Swordfish.Library.csproj" />
      <ProjectReference Include="..\WaywardBeyond.Config\WaywardBeyond.Config.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="assets\**\*.*" CopyToOutputDirectory="Always" />
    </ItemGroup>

    <ItemGroup>
        <NsdFiles Include="Nsd/components.nsd" NeedlefishPartial="true" />
        <NsdFiles Include="Nsd/network.nsd" NeedlefishPartial="true" />
    </ItemGroup>

</Project>
