#version 1.0;
#namespace WaywardBeyond.Shared.Data;

message NewWorldRequest
{
    string Name = 0;
    string Seed = 1;
    int GameMode = 2;
}

message NewWorldResponse
{
    string LevelGuid = 1;
    bool Success = 2;
}

message ListWorldsRequest
{
    uint Dummy = 0;
}

message ListWorldsResponse
{
    Level[] Levels = 50;
}

message DeleteWorldRequest
{
    string LevelGuid = 0;
}

message DeleteWorldResponse
{
    bool Success = 1;
}

message SaveWorldRequest
{
    uint Dummy = 0;
}

message SaveWorldResponse
{
    bool Success = 1;
}

message PublicView
{
    ulong CharacterId = 0;
    string Name = 1;
    int Body = 2;
}

message JoinRequest
{
    string LevelGuid = 0;
    ulong CharacterId = 1;
    PublicView PublicView = 2;
}

message JoinAccept
{
    Level Level = 0;
    float SpawnX = 1;
    float SpawnY = 2;
    float SpawnZ = 3;
    float OrientationX = 4;
    float OrientationY = 5;
    float OrientationZ = 6;
    float OrientationW = 7;
    ulong PlayerEntity = 8;
}

message WorldEntityAdd
{
    VoxelEntityData VoxelEntity = 0;
}

message WorldStreamComplete
{
    byte Dummy = 0;
}

message LeaveGameRequest
{
    byte Dummy = 0;
}