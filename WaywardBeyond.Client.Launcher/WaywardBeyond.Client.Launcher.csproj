<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Wayward Beyond</AssemblyName>
        <OutputType>Exe</OutputType>
        <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>resources/waywardbeyond.ico</ApplicationIcon>
        <IsPackable>false</IsPackable>
        <BeautyLibsDir>./lib</BeautyLibsDir>
        <BeautyUsePatch>True</BeautyUsePatch>
        <BeautyExcludes>*glfw*</BeautyExcludes>
        <BeautyOnPublishOnly>True</BeautyOnPublishOnly>
        <SelfContained Condition="'$(Configuration)' == 'Release' or '$(RuntimeIdentifier)' != ''">true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WaywardBeyond.Data\WaywardBeyond.Data.csproj" />
        <ProjectReference Include="..\Swordfish\Swordfish.csproj" ModulePath="swordfish" />
        <ProjectReference Include="..\WaywardBeyond.Skills\WaywardBeyond.Skills.csproj" ModulePath="waywardbeyond.skills" />
        <ProjectReference Include="..\WaywardBeyond.Bricks\WaywardBeyond.Bricks.csproj" ModulePath="waywardbeyond.bricks" />
        <ProjectReference Include="..\WaywardBeyond.Items\WaywardBeyond.Items.csproj" ModulePath="waywardbeyond.items" />
        <ProjectReference Include="..\WaywardBeyond.Recipes\WaywardBeyond.Recipes.csproj" ModulePath="waywardbeyond.recipes" />
        <ProjectReference Include="..\WaywardBeyond.Bodies\WaywardBeyond.Bodies.csproj" ModulePath="waywardbeyond.bodies" />
        <ProjectReference Include="..\WaywardBeyond.Client\WaywardBeyond.Client.csproj" ModulePath="waywardbeyond.client" />
        <ProjectReference Include="..\WaywardBeyond.Server\WaywardBeyond.Server.csproj" ModulePath="waywardbeyond.server" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="nulastudio.NetBeauty" Version="2.1.5.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="config\modules.toml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="config\physics.toml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="config\logging.toml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Import Project="..\Shoal.Build\build\Shoal.Build.targets" />

</Project>
