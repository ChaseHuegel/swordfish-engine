<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <Version>0.1.0-alpha</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Shoal\Shoal.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!--  Private: consumers see the option extensions, not the nsd-rpc assemblies. -->
      <PackageReference Include="NsdRpc" Version="0.3.0" PrivateAssets="all" />
      <PackageReference Include="NsdRpc.Tcp" Version="0.3.0" PrivateAssets="all" />
    </ItemGroup>

</Project>
