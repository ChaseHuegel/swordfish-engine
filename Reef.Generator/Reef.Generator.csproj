<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Version>0.1.0</Version>
    <Authors>Chase Huegel</Authors>
    <Description>Compile-time source generator for Reef Markup (.rml) and Reef Style Sheets (.rss).</Description>
    <PackageId>Reef.Generator</PackageId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);RS2008;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/Reef.Generator.props" Pack="true" PackagePath="build/" />
    <None Include="Schemas/reef.xsd" Pack="true" PackagePath="schemas/" />
    <None Include="Schemas/catalog.xml" Pack="true" PackagePath="schemas/" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Reef.Generator.Tests" />
  </ItemGroup>

</Project>
