<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <Version>0.1.0-alpha</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Swordfish.ECS\Swordfish.ECS.csproj" />
        <ProjectReference Include="..\Swordfish\Swordfish.csproj" Private="false" ExcludeAssets="runtime" IncludeAssets="compile" />
        <ProjectReference Include="..\Swordfish.Library\Swordfish.Library.csproj" />
        <ProjectReference Include="..\WaywardBeyond.Data\WaywardBeyond.Data.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NsdRpc" Version="0.3.0" />
        <PackageReference Include="NsdRpc.Tcp" Version="0.3.0" />
        <!--  The 0.3.0 package ships the generator under lib/, so add it as an analyzer explicitly. -->
        <PackageReference Include="NsdRpc.Generators" Version="0.3.0" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
        <Analyzer Include="$(PkgNsdRpc_Generators)/lib/netstandard2.0/NsdRpc.Generators.dll" />
    </ItemGroup>

</Project>
