<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>WaywardBeyond.Server.Launcher</AssemblyName>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <BeautyLibsDir>./lib</BeautyLibsDir>
        <BeautyUsePatch>True</BeautyUsePatch>
        <BeautyExcludes>*glfw*</BeautyExcludes>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shoal\Shoal.csproj" />
        <ProjectReference Include="..\Shoal.Extensions.Swordfish\Shoal.Extensions.Swordfish.csproj" />
        <ProjectReference Include="..\Swordfish\Swordfish.csproj" />
        <ProjectReference Include="..\WaywardBeyond.Shared.Bricks\WaywardBeyond.Shared.Bricks.csproj" ModulePath="waywardbeyond.shared.bricks" />
        <ProjectReference Include="..\WaywardBeyond.Shared.Skills\WaywardBeyond.Shared.Skills.csproj" ModulePath="waywardbeyond.shared.skills" />
        <ProjectReference Include="..\WaywardBeyond.Shared.Bodies\WaywardBeyond.Shared.Bodies.csproj" ModulePath="waywardbeyond.shared.bodies" />
        <ProjectReference Include="..\WaywardBeyond.Server.Core\WaywardBeyond.Server.Core.csproj" ModulePath="waywardbeyond.server.core" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="nulastudio.NetBeauty" Version="2.1.5.0" />
        <!--  The server embeds the engine's PhysicsComponent/JoltPhysicsSystem, so the Jolt runtime ships. -->
        <PackageReference Include="JoltPhysicsSharp" Version="2.17.5" />
    </ItemGroup>

    <ItemGroup>
        <None Update="config\modules.toml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="config\physics.toml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Import Project="..\Shoal.Build\build\Shoal.Build.targets" />

</Project>